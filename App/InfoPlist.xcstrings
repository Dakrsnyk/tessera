    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardane zeigt deine nächsten Termine im Widget „Als Nächstes“ und in der Planung. Nichts verlässt dein iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardane shows your upcoming events in the Up Next widget and in Planning. Nothing leaves your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardane muestra tus próximas citas en el widget Próximo y en Planificación. Nada sale de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardane affiche tes prochains rendez-vous dans le widget À venir et dans Planning. Rien ne quitte ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardane mostra i tuoi prossimi appuntamenti nel widget In arrivo e in Pianificazione. Nulla lascia il tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardaneは「次の予定」ウィジェットと「プランニング」に今後の予定を表示します。データがiPhoneの外に出ることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ardane mostra seus próximos compromissos no widget A seguir e no Planejamento. Nada sai do seu iPhone."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wird nur zum Scannen eines Lebensmittel-Barcodes oder zum Fotografieren deiner Mahlzeit verwendet. Die Analyse erfolgt auf deinem iPhone: Es wird kein Foto gespeichert oder gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is only used to scan a food's barcode or photograph your meal. The analysis happens on your iPhone: no photo is saved or sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara solo se usa para escanear el código de barras de un alimento o fotografiar tu plato. El análisis se hace en tu iPhone: ninguna foto se guarda ni se envía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra sert uniquement à scanner le code-barres d'un aliment ou à photographier ton plat. L'analyse se fait sur ton iPhone : aucune photo n'est enregistrée ni envoyée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera serve solo a scansionare il codice a barre di un alimento o a fotografare il tuo piatto. L'analisi avviene sul tuo iPhone: nessuna foto viene salvata o inviata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラは食品のバーコードの読み取りと、料理の撮影のためだけに使用します。解析はiPhone上で行われ、写真が保存または送信されることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera é usada apenas para ler o código de barras de um alimento ou fotografar seu prato. A análise é feita no seu iPhone: nenhuma foto é salva ou enviada."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort wird nur verwendet, um das Wetter in deiner Stadt zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is only used to find the weather in your city."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación solo se usa para encontrar el clima de tu ciudad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta position sert uniquement à trouver la météo de ta ville."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua posizione serve solo a trovare il meteo della tua città."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報はあなたの街の天気を調べるためだけに使用します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua localização é usada apenas para encontrar o clima da sua cidade."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardane liest deine Schritte, Distanz und Stockwerke mit dem Bewegungssensor deines iPhone, für „Mein Tag“ und Fitness. Nichts verlässt dein iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardane reads your steps, distance and floors with your iPhone's motion sensor, for “My Day” and Fitness. Nothing leaves your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardane lee tus pasos, distancia y pisos con el sensor de movimiento de tu iPhone, para «Mi día» y Fitness. Nada sale de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardane lit tes pas, ta distance et tes étages avec le capteur de ton iPhone, pour Mon Quotidien et Fitness. Rien ne quitte ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardane legge i tuoi passi, la distanza e i piani con il sensore di movimento del tuo iPhone, per «La mia giornata» e Fitness. Nulla lascia il tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ArdaneはiPhoneの動きセンサーで歩数・距離・階数を読み取り、「マイデイ」とフィットネスに使います。データがiPhoneの外に出ることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ardane lê seus passos, distância e andares com o sensor de movimento do seu iPhone, para “Meu dia” e Fitness. Nada sai do seu iPhone."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardane speichert die Hintergrundbilder, die du im Store auswählst, in Fotos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardane saves the wallpapers you pick in the Store to Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardane guarda en Fotos los fondos de pantalla que eliges en la Tienda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardane enregistre dans Photos les fonds d'écran que tu choisis dans le Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardane salva in Foto gli sfondi che scegli nello Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardaneはストアで選んだ壁紙を写真に保存します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ardane salva no Fotos os papéis de parede que você escolhe na Loja."
          }
        }
      }
    }
  },
  "version": "1.0"
}