    "Répétition espacée : une fiche sue revient dans 1, 2, 4, 8 puis 16 jours ; une fiche ratée revient dans 10 minutes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaced Repetition: Eine gewusste Karte kommt nach 1, 2, 4, 8 und dann 16 Tagen wieder; eine nicht gewusste nach 10 Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaced repetition: a card you knew comes back in 1, 2, 4, 8, then 16 days; a missed card comes back in 10 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetición espaciada: una tarjeta que sabías vuelve en 1, 2, 4, 8 y 16 días; una tarjeta fallada vuelve en 10 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétition espacée : une fiche sue revient dans 1, 2, 4, 8 puis 16 jours ; une fiche ratée revient dans 10 minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripetizione dilazionata: una carta saputa torna dopo 1, 2, 4, 8 e poi 16 giorni; una carta sbagliata torna dopo 10 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間隔反復: 覚えていたカードは1日、2日、4日、8日、16日後に、間違えたカードは10分後に戻ってきます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetição espaçada: um cartão que você sabia volta em 1, 2, 4, 8 e depois 16 dias; um cartão errado volta em 10 minutos."
          }
        }
      }
    },
    "Répétition espacée : une fiche sue revient dans 1, 2, 4, 8 puis 16 jours. Révise-les depuis le widget.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verteilte Wiederholung: Eine gewusste Karte kommt nach 1, 2, 4, 8 und dann 16 Tagen wieder. Wiederhole sie im Widget."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaced repetition: a card you know comes back in 1, 2, 4, 8, then 16 days. Review them from the widget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetición espaciada: una tarjeta que sabes vuelve en 1, 2, 4, 8 y luego 16 días. Repásalas desde el widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétition espacée : une fiche sue revient dans 1, 2, 4, 8 puis 16 jours. Révise-les depuis le widget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripetizione dilazionata: una scheda che sai torna dopo 1, 2, 4, 8 e poi 16 giorni. Ripassale dal widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間隔反復：覚えたカードは1、2、4、8、16日後に再び出てきます。ウィジェットから復習しましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetição espaçada: um cartão que você sabe volta em 1, 2, 4, 8 e depois 16 dias. Revise pelo widget."
          }
        }
      }
    },
