    "Fais quelques séances : tes charges, ton volume et tes records apparaîtront ici.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach ein paar Trainings: Deine Gewichte, dein Volumen und deine Rekorde erscheinen dann hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do a few workouts: your weights, volume and records will show up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz unos cuantos entrenamientos: tus pesos, tu volumen y tus récords aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais quelques séances : tes charges, ton volume et tes records apparaîtront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai qualche allenamento: carichi, volume e record appariranno qui."
          }
