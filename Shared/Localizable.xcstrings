    "Pour 2 widgets en grand, chacun doit exister en moyen : ajoute un 3e ou un 4e widget.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für 2 Widgets in Groß muss jedes in Mittel verfügbar sein: Füge ein 3. oder 4. Widget hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For 2 widgets in large, each must be available in medium: add a 3rd or 4th widget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para 2 widgets en grande, cada uno debe existir en mediano: añade un 3.º o un 4.º widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour 2 widgets en grand, chacun doit exister en moyen : ajoute un 3e ou un 4e widget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per 2 widget in grande, ognuno deve esistere in medio: aggiungi un 3º o un 4º widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大サイズで2つ並べるには、どちらにも中サイズが必要です。3つ目か4つ目のウィジェットを追加してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para 2 widgets em grande, cada um precisa existir em médio: adicione um 3º ou 4º widget."
          }
        }
      }
    },
    "Pour 3 widgets, l'un d'eux doit exister en moyen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei 3 Widgets muss eines davon in Mittel verfügbar sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For 3 widgets, one of them must be available in medium."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para 3 widgets, uno de ellos debe existir en mediano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour 3 widgets, l'un d'eux doit exister en moyen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per 3 widget, uno di loro deve esistere in medio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3つ並べるには、そのうち1つに中サイズが必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
