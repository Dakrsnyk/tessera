    "Banc incliné à 30-45° : la barre descend vers le haut de la poitrine.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank auf 30-45°: Die Stange senkt sich zur oberen Brust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bench at 30-45°: the bar lowers to your upper chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Banco inclinado a 30-45°: la barra baja hacia la parte alta del pecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banc incliné à 30-45° : la barre descend vers le haut de la poitrine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Panca inclinata a 30-45°: il bilanciere scende verso la parte alta del petto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベンチは30〜45°：バーは胸の上部に下ろします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Banco inclinado a 30-45°: a barra desce em direção à parte alta do peito."
          }
        }
      }
    },
    "Banc à 30-45°, haltères au niveau du haut de la poitrine.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank auf 30-45°, Kurzhanteln auf Höhe der oberen Brust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bench at 30-45°, dumbbells at upper-chest level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Banco a 30-45°, mancuernas a la altura de la parte alta del pecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banc à 30-45°, haltères au niveau du haut de la poitrine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Panca a 30-45°, manubri all'altezza della parte alta del petto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベンチは30〜45°、ダンベルは胸の上部の高さに。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Banco a 30-45°, halteres na altura da parte alta do peito."
          }
        }
      }
    },
    "Banc à 45°, descends le buste puis remonte jusqu'à l'alignement, sans cambrer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank bei 45°, senke den Oberkörper und komme bis zur geraden Linie hoch, ohne ins Hohlkreuz zu gehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bench at 45°, lower your torso then come back up to a straight line, without arching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Banco a 45°, baja el torso y sube hasta quedar alineado, sin arquear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banc à 45°, descends le buste puis remonte jusqu'à l'alignement, sans cambrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Panca a 45°, abbassa il busto poi risali fino all'allineamento, senza inarcare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "45°のベンチで、上体を下ろしてから一直線になるまで戻します。反らしすぎないで。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Banco a 45°, desça o tronco e suba até ficar alinhado, sem arquear."
          }
        }
      }
    },
