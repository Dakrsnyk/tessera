    "Inspire avant de descendre, expire en remontant.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Absenken einatmen, beim Hochkommen ausatmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe in before going down, breathe out as you come up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhala antes de bajar, exhala al subir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspire avant de descendre, expire en remontant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspira prima di scendere, espira mentre risali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下りる前に吸い、立ち上がりながら吐きましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspire antes de descer, expire ao subir."
          }
        }
      }
    },
    "Inspire en avançant, expire en revenant.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Atme beim Vorrollen ein, beim Zurückkommen aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhale as you roll out, exhale as you come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhala al avanzar, exhala al volver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspire en avançant, expire en revenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspira andando avanti, espira tornando indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前に出るときに吸い、戻るときに吐きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspire ao ir, expire ao voltar."
          }
        }
      }
    },
    "Inspire en bas, expire en poussant.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten einatmen, beim Drücken ausatmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe in at the bottom, breathe out as you press."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhala abajo, exhala al empujar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspire en bas, expire en poussant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspira in basso, espira mentre spingi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下で息を吸い、押しながら吐きましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspire embaixo, expire ao empurrar."
          }
        }
