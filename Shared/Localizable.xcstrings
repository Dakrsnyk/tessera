    "Allonge les bras devant toi au sol et relâche.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strecke die Arme vor dir auf dem Boden aus und lass los."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stretch your arms out on the floor in front of you and let go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estira los brazos frente a ti en el suelo y suelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allonge les bras devant toi au sol et relâche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allunga le braccia davanti a te a terra e rilassati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕を前の床に伸ばして、力を抜きましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estique os braços à sua frente no chão e relaxe."
          }
        }
      }
    },
    "Allongé ou assis dans la machine, rouleau au-dessus des talons.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liegend oder sitzend im Gerät, Polster knapp über den Fersen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying or seated in the machine, pad just above your heels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acostado o sentado en la máquina, rodillo sobre los talones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé ou assis dans la machine, rouleau au-dessus des talons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiato o seduto nella macchina, rullo sopra i talloni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンに寝る、または座り、パッドをかかとの少し上に当てましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deitado ou sentado na máquina, rolo acima dos calcanhares."
          }
        }
      }
    },
    "Allongé sur l'eau sur le ventre, corps aligné, visage dans l'eau.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Bauch im Wasser liegen, Körper gestreckt, Gesicht im Wasser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Float face down on the water, body aligned, face in the water."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flotando boca abajo en el agua, cuerpo alineado, cara dentro del agua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur l'eau sur le ventre, corps aligné, visage dans l'eau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiato a pancia in giù sull'acqua, corpo allineato, viso in acqua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水面にうつ伏せで浮かび、体はまっすぐ、顔は水の中に。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deitado de bruços na água, corpo alinhado, rosto na água."
          }
        }
      }
    },
    "Allongé sur le banc, yeux sous la charge, pieds à plat au sol, omoplates serrées et abaissées.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Bank liegend, Augen unter der Stange, Füße flach auf dem Boden, Schulterblätter zusammen- und nach unten gezogen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying on the bench, eyes under the bar, feet flat on the floor, shoulder blades squeezed together and down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acostado en el banco, con los ojos bajo la barra, los pies planos en el suelo y los omóplatos juntos y hacia abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur le banc, yeux sous la charge, pieds à plat au sol, omoplates serrées et abaissées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiato sulla panca, occhi sotto il carico, piedi appoggiati a terra, scapole strette e abbassate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベンチに仰向けになり、目はバーの真下、足は床にしっかりつけ、肩甲骨を寄せて下げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deitado no banco, com os olhos sob a carga, os pés apoiados no chão e as escápulas juntas e para baixo."
          }
        }
      }
    },
    "Allongé sur le côté, avant-bras au sol, coude sous l'épaule, jambes tendues l'une sur l'autre.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg dich auf die Seite, Unterarm am Boden, Ellbogen unter der Schulter, Beine gestreckt übereinander."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your side, forearm on the floor, elbow under your shoulder, legs straight and stacked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuéstate de lado, antebrazo en el suelo, codo bajo el hombro, piernas estiradas una sobre otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur le côté, avant-bras au sol, coude sous l'épaule, jambes tendues l'une sur l'autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiati su un fianco, avambraccio a terra, gomito sotto la spalla, gambe tese una sull'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横向きに寝て前腕を床につき、ひじは肩の下、脚は伸ばして重ねます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deite de lado, antebraço no chão, cotovelo sob o ombro, pernas esticadas uma sobre a outra."
          }
        }
      }
    },
    "Allongé sur le dos (ou suspendu à une barre), jambes tendues.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Rücken liegen (oder an einer Stange hängen), Beine gestreckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your back (or hang from a bar), legs straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumbado boca arriba (o colgado de una barra), piernas estiradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur le dos (ou suspendu à une barre), jambes tendues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiato sulla schiena (o appeso a una sbarra), gambe tese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仰向け（またはバーにぶら下がって）、脚を伸ばします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deitado de costas (ou pendurado em uma barra), pernas esticadas."
          }
        }
      }
    },
    "Allongé sur le dos, bras tendus derrière la tête, jambes tendues.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg dich auf den Rücken, Arme gestreckt hinter dem Kopf, Beine gestreckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your back, arms extended behind your head, legs straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuéstate boca arriba, brazos estirados detrás de la cabeza y piernas estiradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur le dos, bras tendus derrière la tête, jambes tendues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiati sulla schiena, braccia tese dietro la testa, gambe tese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仰向けに寝て、腕を頭の後ろに伸ばし、脚もまっすぐ伸ばします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deite de costas, braços esticados atrás da cabeça, pernas esticadas."
          }
        }
      }
    },
    "Allongé sur le dos, bras tendus vers le plafond, hanches et genoux pliés à 90°.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg dich auf den Rücken, Arme gestreckt zur Decke, Hüften und Knie auf 90° gebeugt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your back, arms straight toward the ceiling, hips and knees bent at 90°."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuéstate boca arriba, brazos estirados hacia el techo, caderas y rodillas flexionadas a 90°."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur le dos, bras tendus vers le plafond, hanches et genoux pliés à 90°."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiati sulla schiena, braccia tese verso il soffitto, anche e ginocchia piegate a 90°."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仰向けに寝て腕を天井に伸ばし、股関節とひざを90度に曲げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deite de costas, braços esticados para o teto, quadril e joelhos dobrados a 90°."
          }
        }
      }
    },
    "Allongé sur le dos, genoux pliés, pieds au sol, mains aux tempes ou croisées sur la poitrine.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Rücken liegen, Knie gebeugt, Füße am Boden, Hände an den Schläfen oder auf der Brust gekreuzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your back, knees bent, feet flat on the floor, hands at your temples or crossed over your chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumbado boca arriba, rodillas flexionadas, pies en el suelo, manos en las sienes o cruzadas sobre el pecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur le dos, genoux pliés, pieds au sol, mains aux tempes ou croisées sur la poitrine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiato sulla schiena, ginocchia piegate, piedi a terra, mani alle tempie o incrociate sul petto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仰向けで、ひざを曲げ、足を床につけ、手はこめかみに添えるか胸の前で交差させます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deitado de costas, joelhos dobrados, pés no chão, mãos nas têmporas ou cruzadas sobre o peito."
          }
        }
      }
    },
    "Allongé sur le dos, genoux pliés, pieds à plat largeur de hanches, bras le long du corps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Rücken liegend, Knie gebeugt, Füße hüftbreit flach am Boden, Arme neben dem Körper."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying on your back, knees bent, feet flat hip-width apart, arms at your sides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acostado boca arriba, rodillas dobladas, pies apoyados al ancho de la cadera, brazos junto al cuerpo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur le dos, genoux pliés, pieds à plat largeur de hanches, bras le long du corps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiato sulla schiena, ginocchia piegate, piedi a terra alla larghezza dei fianchi, braccia lungo il corpo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仰向けに寝て膝を曲げ、足裏を腰幅で床に着け、腕は体の横に置いた姿勢。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deitado de costas, joelhos dobrados, pés apoiados na largura do quadril, braços ao lado do corpo."
          }
        }
      }
    },
    "Allongé sur le dos, kettlebell bras tendu vers le plafond, genou du même côté plié, pied au sol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg dich auf den Rücken, Kettlebell im gestreckten Arm zur Decke, Knie derselben Seite gebeugt, Fuß am Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your back, kettlebell in your outstretched arm toward the ceiling, same-side knee bent, foot on the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuéstate boca arriba con la kettlebell en el brazo estirado hacia el techo, la rodilla del mismo lado flexionada y el pie en el suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur le dos, kettlebell bras tendu vers le plafond, genou du même côté plié, pied au sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiati sulla schiena, kettlebell nel braccio teso verso il soffitto, ginocchio dello stesso lato piegato, piede a terra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仰向けに寝て、ケトルベルを持った腕を天井に伸ばし、同じ側のひざを曲げて足を床につけます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deite de costas, kettlebell no braço esticado para o teto, joelho do mesmo lado dobrado, pé no chão."
          }
        }
      }
    },
    "Allongé sur le dos, un pied à plat, l'autre jambe tendue dans l'alignement de la cuisse.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Rücken liegend, ein Fuß flach am Boden, das andere Bein gestreckt in Linie mit dem Oberschenkel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying on your back, one foot flat, other leg straight in line with your thigh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acostado boca arriba, un pie apoyado, la otra pierna extendida alineada con el muslo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur le dos, un pied à plat, l'autre jambe tendue dans l'alignement de la cuisse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiato sulla schiena, un piede a terra, l'altra gamba tesa in linea con la coscia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仰向けに寝て片足の裏を床に着け、もう片方の脚は太ももと一直線に伸ばした姿勢。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deitado de costas, um pé apoiado, a outra perna estendida alinhada com a coxa."
          }
        }
      }
    },
    "Allongé sur le ventre, bras tendus devant.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Bauch liegen, Arme nach vorn gestreckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your stomach, arms stretched out in front."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumbado boca abajo, brazos estirados al frente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur le ventre, bras tendus devant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiato a pancia in giù, braccia tese in avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うつ伏せで、腕を前に伸ばします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deitado de bruços, braços esticados à frente."
          }
        }
      }
    },
    "Allongé sur le ventre, mains au sol sous les épaules, jambes allongées.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Bauch liegend, Hände unter den Schultern am Boden, Beine gestreckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying face down, hands on the floor under your shoulders, legs extended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boca abajo, manos en el suelo bajo los hombros, piernas estiradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur le ventre, mains au sol sous les épaules, jambes allongées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiato a pancia in giù, mani a terra sotto le spalle, gambe distese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うつ伏せになり、手は肩の下の床に、脚は伸ばします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deitado de bruços, mãos no chão sob os ombros, pernas esticadas."
          }
        }
      }
    },
    "Allongé sur le ventre, pousse doucement sur les mains, hanches au sol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Bauch liegend, drücke dich sanft mit den Händen hoch, Hüfte am Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying on your stomach, gently press up on your hands, hips on the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumbado boca abajo, empuja suavemente con las manos, caderas en el suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur le ventre, pousse doucement sur les mains, hanches au sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiato a pancia in giù, spingi dolcemente sulle mani, fianchi a terra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うつ伏せになり、手でゆっくり押し上げます。腰は床に付けたまま。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deitado de barriga para baixo, empurre suavemente com as mãos, quadris no chão."
          }
        }
      }
    },
    "Allongé sur un banc, bras tendus au-dessus de la poitrine.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einer Bank liegend, Arme gestreckt über der Brust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying on a bench, arms straight above your chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acostado en un banco, brazos extendidos sobre el pecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur un banc, bras tendus au-dessus de la poitrine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiato su una panca, braccia tese sopra il petto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベンチに仰向けに寝て、腕を胸の上に伸ばしましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deitado em um banco, braços esticados acima do peito."
          }
        }
      }
    },
