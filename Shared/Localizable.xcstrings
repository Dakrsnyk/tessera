            "value": "Indica tu presupuesto del mes para ver cuánto te queda cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne ton budget du mois pour voir ce qu'il te reste chaque jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
