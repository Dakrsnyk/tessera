    "Dos au banc, mains sur le bord, doigts vers l'avant, jambes allongées, talons au sol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rücken zur Bank, Hände auf der Kante, Finger nach vorn, Beine gestreckt, Fersen am Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to the bench, hands on the edge, fingers forward, legs extended, heels on the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De espaldas al banco, manos en el borde, dedos hacia adelante, piernas estiradas, talones en el suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos au banc, mains sur le bord, doigts vers l'avant, jambes allongées, talons au sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiena verso la panca, mani sul bordo, dita in avanti, gambe distese, talloni a terra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベンチに背を向け、手をベンチの縁に置いて指は前向き、脚を伸ばしてかかとを床に着けた姿勢。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De costas para o banco, mãos na borda, dedos para a frente, pernas estendidas, calcanhares no chão."
          }
        }
      }
    },
    "Dos au mur, cuisses parallèles au sol ; tiens la position.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rücken an der Wand, Oberschenkel parallel zum Boden; halte die Position."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back against the wall, thighs parallel to the floor; hold the position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De espaldas a la pared, muslos paralelos al suelo; mantén la posición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos au mur, cuisses parallèles au sol ; tiens la position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiena al muro, cosce parallele al pavimento; mantieni la posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁に背を付け、太ももを床と平行に。その姿勢をキープします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Costas na parede, coxas paralelas ao chão; mantenha a posição."
          }
        }
      }
    },
    "Dos au sol (ou le haut du dos sur un banc), genoux pliés, pieds à plat largeur de hanches.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rücken am Boden (oder oberer Rücken auf einer Bank), Knie gebeugt, Füße flach und hüftbreit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying on your back (or upper back on a bench), knees bent, feet flat and hip-width apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acostado boca arriba (o con la parte alta de la espalda sobre un banco), rodillas flexionadas, pies planos al ancho de las caderas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos au sol (ou le haut du dos sur un banc), genoux pliés, pieds à plat largeur de hanches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiena a terra (o parte alta della schiena su una panca), ginocchia piegate, piedi appoggiati a terra alla larghezza del bacino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仰向けに寝て(または上背部をベンチに乗せて)、ひざを曲げ、足裏を床につけて腰幅に開きましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deitado de costas no chão (ou com a parte alta das costas em um banco), joelhos dobrados, pés apoiados na largura do quadril."
          }
        }
      }
    },
    "Dos et épaules contre les appuis de la machine, pieds largeur d'épaules sur le plateau.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rücken und Schultern an den Polstern der Maschine, Füße schulterbreit auf der Plattform."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back and shoulders against the machine pads, feet shoulder-width apart on the platform."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espalda y hombros contra los apoyos de la máquina, pies al ancho de los hombros sobre la plataforma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos et épaules contre les appuis de la machine, pieds largeur d'épaules sur le plateau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiena e spalle contro gli appoggi della macchina, piedi alla larghezza delle spalle sulla pedana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背中と肩をマシンのパッドに当て、足はフットプレートに肩幅で置いた姿勢。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Costas e ombros contra os apoios da máquina, pés na largura dos ombros na plataforma."
          }
        }
      }
    },
    "Dos le plus droit possible.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rücken so gerade wie möglich."
