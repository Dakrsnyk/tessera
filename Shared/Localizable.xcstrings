    "Au moins jusqu'aux cuisses parallèles au sol si ta mobilité le permet, dos neutre.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens bis die Oberschenkel parallel zum Boden sind, wenn deine Beweglichkeit es zulässt, Rücken neutral."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least until your thighs are parallel to the floor if your mobility allows, neutral back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos hasta que los muslos queden paralelos al suelo, si tu movilidad lo permite, con la espalda neutra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins jusqu'aux cuisses parallèles au sol si ta mobilité le permet, dos neutre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno fino alle cosce parallele al pavimento, se la tua mobilità lo permette, schiena neutra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "可動性が許せば、太ももが床と平行になるまで。背中はニュートラルに。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos até as coxas ficarem paralelas ao chão, se sua mobilidade permitir, com as costas neutras."
          }
        }
      }
    },
    "Au moins jusqu'aux cuisses parallèles, buste droit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens bis die Oberschenkel parallel sind, Oberkörper aufrecht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least to parallel thighs, torso upright."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos hasta que los muslos queden paralelos, torso erguido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins jusqu'aux cuisses parallèles, buste droit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno fino alle cosce parallele, busto dritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少なくとも太ももが平行になるまで、上体は起こしたまま。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos até as coxas ficarem paralelas, tronco reto."
          }
        }
      }
    },
