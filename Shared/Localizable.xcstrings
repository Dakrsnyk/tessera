    "Contre un mur, descends la tête vers le sol sous contrôle.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Rücken zur Wand: Senke den Kopf kontrolliert Richtung Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Against a wall, lower your head toward the floor with control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contra una pared, baja la cabeza hacia el suelo con control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contre un mur, descends la tête vers le sol sous contrôle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contro un muro, abbassa la testa verso il pavimento con controllo."
          }
        },
        "ja": {
