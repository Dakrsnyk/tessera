    "Les bras alternent : l'un tire sous l'eau pendant que l'autre revient au-dessus.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Arme wechseln sich ab: Einer zieht unter Wasser, während der andere über Wasser zurückkommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternate your arms: one pulls underwater while the other comes back over the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los brazos se alternan: uno tira bajo el agua mientras el otro vuelve por encima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bras alternent : l'un tire sous l'eau pendant que l'autre revient au-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le braccia si alternano: una tira sott'acqua mentre l'altra torna sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕は交互に動かします。片腕が水中でかく間に、もう片腕は水上を戻ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os braços se alternam: um puxa debaixo d'água enquanto o outro volta por cima."
          }
        }
      }
    },
    "Les bras restent légèrement inclinés vers la tête.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Arme bleiben leicht zum Kopf geneigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your arms stay slightly angled toward your head."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los brazos se mantienen ligeramente inclinados hacia la cabeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bras restent légèrement inclinés vers la tête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le braccia restano leggermente inclinate verso la testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕は頭のほうへ少し傾けたままにしましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os braços ficam levemente inclinados em direção à cabeça."
          }
        }
      }
    },
    "Les cases se décochent chaque matin. Coche-les depuis le widget.": {
      "extractionState": "manual",
