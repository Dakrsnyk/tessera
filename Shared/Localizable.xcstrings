    "Lève et abaisse les bras en alternance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb und senk die Arme abwechselnd."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise and lower your arms alternately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube y baja los brazos de forma alterna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève et abaisse les bras en alternance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza e abbassa le braccia in alternanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕を交互に上げ下げします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante e abaixe os braços alternadamente."
          }
        }
      }
    },
    "Lève le genou plié sur le côté.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb das gebeugte Knie zur Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift your bent knee out to the side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta la rodilla flexionada hacia el lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève le genou plié sur le côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solleva di lato il ginocchio piegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲げたひざを横に上げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante o joelho dobrado para o lado."
          }
        }
      }
    },
    "Lève les bras devant toi jusqu'à hauteur des épaules.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebe die Arme vor dir bis auf Schulterhöhe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise your arms in front of you to shoulder height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube los brazos al frente hasta la altura de los hombros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève les bras devant toi jusqu'à hauteur des épaules."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solleva le braccia davanti a te fino all'altezza delle spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕を前に肩の高さまで上げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante os braços à sua frente até a altura dos ombros."
          }
        }
      }
    },
    "Lève les bras sur les côtés jusqu'à hauteur des épaules.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebe die Arme seitlich bis auf Schulterhöhe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise your arms out to the sides to shoulder height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta los brazos hacia los lados hasta la altura de los hombros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève les bras sur les côtés jusqu'à hauteur des épaules."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solleva le braccia di lato fino all'altezza delle spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕を横に、肩の高さまで上げましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante os braços para os lados até a altura dos ombros."
          }
        }
      }
    },
    "Lève les hanches.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb die Hüften."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift your hips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta las caderas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève les hanches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solleva le anche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腰を持ち上げます。"
          }
        },
        "pt-BR": {
