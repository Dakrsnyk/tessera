    "Pour changer le contenu d'un widget déjà posé : appui long sur le widget, puis « Modifier le widget ».": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um den Inhalt eines bereits platzierten Widgets zu ändern: Widget gedrückt halten und auf „Widget bearbeiten“ tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To change the content of a widget already placed: touch and hold the widget, then tap “Edit Widget”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cambiar el contenido de un widget ya colocado: mantén pulsado el widget y toca “Editar widget”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour changer le contenu d'un widget déjà posé : appui long sur le widget, puis « Modifier le widget »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per cambiare il contenuto di un widget già aggiunto: tieni premuto il widget, poi tocca «Modifica widget»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配置済みのウィジェットの内容を変えるには、ウィジェットを長押しして「ウィジェットを編集」をタップします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mudar o conteúdo de um widget já adicionado: toque e segure o widget e depois toque em “Editar widget”."
          }
        }
      }
    },
    "Pour des widgets Fitness à ton niveau, et des calories brûlées estimées avec ton poids.": {
