    "Rien au programme pour l'instant. Ajoute tes vols, ton hébergement et ce que tu veux faire : tout se range ici jour par jour.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts geplant. Füge deine Flüge, deine Unterkunft und deine Pläne hinzu: Alles landet hier, Tag für Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing planned yet. Add your flights, lodging and whatever you want to do: it all lands here, day by day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada en el programa. Añade tus vuelos, tu alojamiento y lo que quieras hacer: todo se organiza aquí, día por día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien au programme pour l'instant. Ajoute tes vols, ton hébergement et ce que tu veux faire : tout se range ici jour par jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente in programma per ora. Aggiungi i tuoi voli, il tuo alloggio e quello che vuoi fare: tutto si organizza qui, giorno per giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定はまだありません。フライトや宿泊先、やりたいことを追加すると、日ごとにここへまとまります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada na programação por enquanto. Adicione seus voos, sua hospedagem e o que quer fazer: tudo fica organizado aqui, dia a dia."
          }
        }
      }
    },
    "Rien d'urgent, profites-en": {
