    "Saute en lançant les bras vers l'avant.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Springe und schwinge die Arme nach vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump while swinging your arms forward."
          }
        },
        "es": {
          "stringUnit": {
