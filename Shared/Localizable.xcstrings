    "En position de pompe, bras tendus, corps gainé.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Liegestützposition, Arme gestreckt, Körper angespannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get into a push-up position, arms straight, body tight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En posición de flexión, brazos estirados y cuerpo firme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En position de pompe, bras tendus, corps gainé."
          }
        },
        "it": {
