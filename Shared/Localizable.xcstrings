    "Plie le coude pour monter l'haltère vers l'épaule.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beug den Ellbogen und führ die Kurzhantel zur Schulter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend your elbow to curl the dumbbell toward your shoulder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobla el codo para subir la mancuerna hacia el hombro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plie le coude pour monter l'haltère vers l'épaule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piega il gomito per portare il manubrio verso la spalla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肘を曲げてダンベルを肩に向かって上げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobre o cotovelo para levar o halter em direção ao ombro."
          }
        }
      }
    },
    "Plie les coudes pour descendre l'haltère derrière la tête.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beug die Ellbogen und senk die Kurzhantel hinter den Kopf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend your elbows to lower the dumbbell behind your head."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobla los codos para bajar la mancuerna detrás de la cabeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plie les coudes pour descendre l'haltère derrière la tête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piega i gomiti per portare il manubrio dietro la testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肘を曲げてダンベルを頭の後ろに下ろします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobre os cotovelos para descer o halter atrás da cabeça."
          }
        }
      }
    },
    "Plie les coudes pour descendre la charge derrière la tête.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beuge die Ellbogen, um das Gewicht hinter den Kopf zu senken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend your elbows to lower the weight behind your head."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexiona los codos para bajar el peso detrás de la cabeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plie les coudes pour descendre la charge derrière la tête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piega i gomiti per abbassare il carico dietro la testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひじを曲げて、ウェイトを頭の後ろに下ろしましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobre os cotovelos para descer a carga atrás da cabeça."
          }
        }
      }
    },
    "Plie les coudes pour descendre la charge vers le front.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beuge die Ellbogen, um das Gewicht zur Stirn zu senken."
