    "Pas de données de pas pour ce jour : l'iPhone garde environ une semaine, Tessera garde ensuite chaque jour lu.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Schrittdaten für diesen Tag: Das iPhone speichert etwa eine Woche, danach behält Tessera jeden gelesenen Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No step data for this day: the iPhone keeps about a week, then Tessera keeps every day it has read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay datos de pasos para este día: el iPhone guarda una semana aprox. y luego Tessera guarda cada día leído."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de données de pas pour ce jour : l'iPhone garde environ une semaine, Tessera garde ensuite chaque jour lu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun dato sui passi per questo giorno: l'iPhone conserva circa una settimana, poi Tessera conserva ogni giorno letto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日の歩数データはありません。iPhoneは約1週間分を保存し、その後はTesseraが読み取った日を保存します。"
