    "Suspendu à la barre (ou assis à la poulie), mains un peu plus larges que les épaules, bras tendus.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hängend an der Stange (oder sitzend am Kabelzug), Hände etwas weiter als schulterbreit, Arme gestreckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanging from the bar (or seated at the cable), hands slightly wider than your shoulders, arms straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colgado de la barra (o sentado en la polea), manos un poco más separadas que los hombros, brazos extendidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendu à la barre (ou assis à la poulie), mains un peu plus larges que les épaules, bras tendus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appeso alla sbarra (o seduto al cavo), mani un po' più larghe delle spalle, braccia tese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーにぶら下がり(またはケーブルマシンに座り)、手は肩幅より少し広く、腕は伸ばしましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendurado na barra (ou sentado na polia), mãos um pouco mais afastadas que os ombros, braços esticados."
          }
        }
      }
    },
    "Suspendu à la barre, mains largeur d'épaules, bras tendus, pieds décollés du sol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An der Stange hängend, Hände schulterbreit, Arme gestreckt, Füße vom Boden gelöst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanging from the bar, hands shoulder-width apart, arms straight, feet off the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colgado de la barra, manos al ancho de los hombros, brazos extendidos, pies sin tocar el suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendu à la barre, mains largeur d'épaules, bras tendus, pieds décollés du sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appeso alla sbarra, mani alla larghezza delle spalle, braccia tese, piedi sollevati da terra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーにぶら下がり、手幅は肩幅、腕を伸ばして足を床から浮かせた姿勢。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendurado na barra, mãos na largura dos ombros, braços estendidos, pés fora do chão."
          }
        }
      }
    },
