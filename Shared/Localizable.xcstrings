    "Barre au sol au-dessus du milieu du pied, dos plat, bras tendus, épaules légèrement devant la barre.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stange am Boden über der Fußmitte, Rücken gerade, Arme gestreckt, Schultern leicht vor der Stange."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bar on the floor over the middle of your foot, back flat, arms straight, shoulders slightly in front of the bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barra en el suelo sobre la mitad del pie, espalda plana, brazos estirados y hombros ligeramente por delante de la barra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre au sol au-dessus du milieu du pied, dos plat, bras tendus, épaules légèrement devant la barre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilanciere a terra sopra il centro del piede, schiena piatta, braccia tese, spalle leggermente davanti al bilanciere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーは床で足の中央の真上、背中はまっすぐ、腕は伸ばし、肩はバーより少し前に。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Barra no chão sobre o meio do pé, costas retas, braços esticados, ombros levemente à frente da barra."
          }
        }
      }
    },
