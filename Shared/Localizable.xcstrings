    "Dos plaqué au mur, pieds en avant, écartés largeur de hanches.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rücken flach an der Wand, Füße nach vorn, hüftbreit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back flat against the wall, feet forward, hip-width apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espalda pegada a la pared, pies adelante, separados al ancho de la cadera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos plaqué au mur, pieds en avant, écartés largeur de hanches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiena aderente al muro, piedi in avanti, alla larghezza dei fianchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背中を壁にぴったり付け、足は前に出して腰幅に開いた姿勢。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Costas encostadas na parede, pés à frente, afastados na largura do quadril."
          }
        }
      }
    },
    "Dos plaqué, tends un bras et la jambe opposée en alternant.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rücken flach am Boden, strecke einen Arm und das gegenüberliegende Bein im Wechsel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back flat, extend one arm and the opposite leg, alternating."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espalda pegada al suelo, estira un brazo y la pierna contraria, alternando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos plaqué, tends un bras et la jambe opposée en alternant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiena aderente al pavimento, estendi un braccio e la gamba opposta alternando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背中を床に付け、片腕と反対の脚を交互に伸ばします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Costas coladas no chão, estique um braço e a perna oposta, alternando."
          }
        }
      }
    },
    "Dos plat tout le long.": {
