    "Main derrière la tête, pousse doucement le coude avec l'autre main.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand hinter dem Kopf, drücke den Ellbogen sanft mit der anderen Hand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand behind your head, gently push your elbow with the other hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mano detrás de la cabeza, empuja suavemente el codo con la otra mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Main derrière la tête, pousse doucement le coude avec l'autre main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mano dietro la testa, spingi dolcemente il gomito con l'altra mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭の後ろに手を置き、もう一方の手でひじをゆっくり押します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mão atrás da cabeça, empurre suavemente o cotovelo com a outra mão."
          }
        }
      }
    },
    "Mains au mur pour l'équilibre.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hände an der Wand fürs Gleichgewicht."
          }
        },
        "en": {
