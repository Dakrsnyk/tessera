    "Reviens bras tendus en laissant les omoplates s'écarter, sans arrondir le dos.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehre mit gestreckten Armen zurück, lass die Schulterblätter auseinandergleiten, ohne den Rücken zu runden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to straight arms, letting your shoulder blades spread apart, without rounding your back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve con los brazos extendidos dejando que los omóplatos se separen, sin redondear la espalda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviens bras tendus en laissant les omoplates s'écarter, sans arrondir le dos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna con le braccia tese lasciando allargare le scapole, senza curvare la schiena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肩甲骨を開きながら、背中を丸めずに腕を伸ばした状態へ戻りましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte com os braços esticados, deixando as escápulas se afastarem, sem arredondar as costas."
          }
        }
      }
    },
    "Reviens bras tendus sous contrôle.": {
      "extractionState": "manual",
