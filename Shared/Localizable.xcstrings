    "Chaque jour de l'année est un point. Regarde-la avancer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Tag des Jahres ist ein Punkt. Sieh zu, wie es voranschreitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every day of the year is a dot. Watch it move along."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día del año es un punto. Míralo avanzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour de l'année est un point. Regarde-la avancer."
          }
        },
