    "Pose le pied à plat et pousse jusqu'aux orteils.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze den Fuß flach auf und drücke dich bis zu den Zehen ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place your foot flat and push off through your toes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoya el pie completo y empuja hasta la punta de los dedos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose le pied à plat et pousse jusqu'aux orteils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia il piede in piano e spingi fino alle dita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "足裏全体をつき、つま先まで押し出しましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoie o pé inteiro e empurre até a ponta dos dedos."
          }
        }
      }
    },
