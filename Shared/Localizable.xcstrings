    "Des bras ouverts dans la ligne des épaules aux mains jointes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von den geöffneten Armen auf Schulterhöhe bis zu den Händen zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From arms open at shoulder level to hands together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde los brazos abiertos a la altura de los hombros hasta las manos juntas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des bras ouverts dans la ligne des épaules aux mains jointes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalle braccia aperte all'altezza delle spalle fino alle mani unite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肩の高さで開いた腕から、手が合わさるまで。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos braços abertos na altura dos ombros até as mãos juntas."
          }
        }
      }
    },
    "Des bras ouverts à la ligne des épaules jusqu'aux mains jointes devant la poitrine.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
