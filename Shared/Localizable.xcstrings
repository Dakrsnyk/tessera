    "En alterné ou les deux bras ensemble, paumes vers le haut.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abwechselnd oder beide Arme gleichzeitig, Handflächen nach oben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternate arms or both together, palms up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna los brazos o hazlo con los dos a la vez, palmas hacia arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En alterné ou les deux bras ensemble, paumes vers le haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternato o con entrambe le braccia insieme, palmi verso l'alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "交互でも両腕同時でもOK。手のひらは上向きです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternando ou com os dois braços juntos, palmas para cima."
          }
        }
      }
    },
    "En appui sur les avant-bras et la pointe des pieds, coudes sous les épaules.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Unterarmen und Fußspitzen abstützen, Ellbogen unter den Schultern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest on your forearms and toes, elbows under your shoulders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoyado en los antebrazos y las puntas de los pies, con los codos bajo los hombros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En appui sur les avant-bras et la pointe des pieds, coudes sous les épaules."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggiato sugli avambracci e sulle punte dei piedi, gomiti sotto le spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前腕とつま先で支え、ひじは肩の真下に置きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoiado nos antebraços e na ponta dos pés, cotovelos sob os ombros."
          }
        }
      }
    },
    "En appui sur les barres (ou les mains sur un banc derrière toi), bras tendus, épaules basses.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Stütz auf den Barren (oder Hände auf einer Bank hinter dir), Arme gestreckt, Schultern tief."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported on the bars (or hands on a bench behind you), arms straight, shoulders down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoyado en las barras (o con las manos en un banco detrás de ti), brazos estirados, hombros abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En appui sur les barres (ou les mains sur un banc derrière toi), bras tendus, épaules basses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In appoggio sulle parallele (o con le mani su una panca dietro di te), braccia tese, spalle basse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バー（または後ろのベンチに手をつく）で体を支え、腕を伸ばして肩を下げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoiado nas barras (ou com as mãos em um banco atrás de você), braços esticados, ombros baixos."
          }
        }
      }
    },
