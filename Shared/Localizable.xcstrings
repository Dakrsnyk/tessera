    "Passe sous la barre : réception sur l'avant des épaules en squat partiel, coudes hauts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh unter die Stange: Fang sie vorn auf den Schultern in einer halben Kniebeuge, Ellbogen hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop under the bar: catch it on the front of your shoulders in a partial squat, elbows high."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa bajo la barra: recíbela sobre la parte frontal de los hombros en sentadilla parcial, con los codos arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe sous la barre : réception sur l'avant des épaules en squat partiel, coudes hauts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Infilati sotto il bilanciere: ricevilo sulla parte anteriore delle spalle in squat parziale, gomiti alti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーの下にもぐり込み、浅いスクワットで肩の前で受け止めます。ひじは高く。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe por baixo da barra: receba-a na frente dos ombros em agachamento parcial, cotovelos altos."
          }
        }
      }
    },
