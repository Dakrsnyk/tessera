        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus respuestas del principio, que puedes modificar cuando quieras. Al indicarlas una sola vez, se usan en todas tus miniapps y en todos tus widgets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes réponses du début, modifiables à tout moment. Données une fois, elles servent à toutes tes mini-apps et à tous tes widgets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue risposte iniziali, modificabili in qualsiasi momento. Inserite una sola volta, servono a tutte le tue mini-app e a tutti i tuoi widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の回答はいつでも変更できます。一度入力すれば、すべてのミニアプリとウィジェットで使われます。"
          }
