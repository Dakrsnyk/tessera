      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stehend oder sitzend, Gewicht über dem Kopf, Arme gestreckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing or seated, weight held overhead, arms straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie o sentado, peso sostenido sobre la cabeza, brazos extendidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout ou assis, charge tenue au-dessus de la tête, bras tendus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi o seduto, carico tenuto sopra la testa, braccia tese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立つか座って、ウェイトを頭上に持ち、腕を伸ばしましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé ou sentado, carga segurada acima da cabeça, braços esticados."
          }
        }
      }
    },
    "Debout sur le tapis réglé en pente, regard devant.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle dich auf das Band mit Steigung, Blick nach vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand on the belt set to an incline, eyes forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie sobre la cinta con inclinación, mirando al frente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout sur le tapis réglé en pente, regard devant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi sul tapis roulant inclinato, sguardo avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傾斜をつけたベルトの上に立ち、視線は前に。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé na esteira com inclinação, olhando para a frente."
          }
        }
      }
    },
    "Debout sur les pédales du stepper, mains légèrement posées sur les barres.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle dich auf die Pedale des Steppers, Hände leicht auf den Griffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand on the stepper pedals, hands resting lightly on the rails."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie sobre los pedales del stepper, manos apoyadas ligeramente en las barras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout sur les pédales du stepper, mains légèrement posées sur les barres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi sui pedali dello stepper, mani appoggiate leggermente alle barre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステッパーのペダルに立ち、バーに軽く手を添えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé nos pedais do stepper, mãos apoiadas de leve nas barras."
          }
        }
      }
    },
    "Debout sur les pédales, mains sur les poignées mobiles, buste droit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle dich auf die Pedale, Hände an die beweglichen Griffe, Oberkörper aufrecht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand on the pedals, hands on the moving handles, torso upright."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie sobre los pedales, manos en los agarres móviles, torso recto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout sur les pédales, mains sur les poignées mobiles, buste droit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi sui pedali, mani sulle impugnature mobili, busto dritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペダルの上に立ち、動くハンドルを握って、上体はまっすぐに。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé nos pedais, mãos nas alças móveis, tronco reto."
          }
        }
      }
    },
    "Debout sur une jambe, genou légèrement fléchi, haltère dans la main opposée.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem Bein stehend, Knie leicht gebeugt, Kurzhantel in der gegenüberliegenden Hand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing on one leg, knee slightly bent, dumbbell in the opposite hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie sobre una pierna, rodilla un poco flexionada, mancuerna en la mano contraria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout sur une jambe, genou légèrement fléchi, haltère dans la main opposée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi su una gamba, ginocchio leggermente piegato, manubrio nella mano opposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "片脚で立ち、膝を軽く曲げ、反対の手にダンベルを持った姿勢。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé sobre uma perna, joelho levemente flexionado, halter na mão oposta."
          }
        }
      }
    },
    "Debout sur une jambe, l'avant du pied sur une marche, haltère du même côté, l'autre main contre un mur.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steh auf einem Bein, Fußballen auf einer Stufe, Kurzhantel auf derselben Seite, die andere Hand an der Wand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand on one leg, ball of your foot on a step, dumbbell on the same side, other hand against a wall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie sobre una pierna, con la punta del pie en un escalón, la mancuerna del mismo lado y la otra mano contra la pared."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout sur une jambe, l'avant du pied sur une marche, haltère du même côté, l'autre main contre un mur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi su una gamba, avampiede su un gradino, manubrio dallo stesso lato, l'altra mano contro il muro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "片脚で立ち、つま先側をステップに乗せ、同じ側の手にダンベル、反対の手は壁に添えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé numa perna, ponta do pé num degrau, halter do mesmo lado e a outra mão na parede."
          }
        }
      }
    },
    "Debout, attrape la cheville derrière toi, genoux côte à côte.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Stand, greife den Knöchel hinter dir, Knie nebeneinander."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing, grab your ankle behind you, knees side by side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, agarra el tobillo por detrás, rodillas juntas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, attrape la cheville derrière toi, genoux côte à côte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi, afferra la caviglia dietro di te, ginocchia vicine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立って、後ろで足首をつかみ、ひざを揃えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé, segure o tornozelo atrás de você, joelhos lado a lado."
          }
        }
      }
    },
    "Debout, barre en position de squat avant, coudes hauts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steh mit der Stange in Frontkniebeugen-Position, Ellbogen hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand with the bar in front squat position, elbows high."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, con la barra en posición de sentadilla frontal y los codos arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, barre en position de squat avant, coudes hauts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi, bilanciere in posizione di front squat, gomiti alti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーをフロントスクワットの位置に構えて立ち、ひじは高く。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé, barra na posição de agachamento frontal, cotovelos altos."
          }
        }
      }
    },
    "Debout, barre posée sur l'avant des épaules contre les clavicules, bras croisés devant (ou prise olympique), coudes hauts, pieds largeur d'épaules.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Stand, Stange vorn auf den Schultern an den Schlüsselbeinen, Arme vorn gekreuzt (oder olympischer Griff), Ellbogen hoch, Füße schulterbreit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing, bar resting on the front of your shoulders against your collarbones, arms crossed in front (or clean grip), elbows high, feet shoulder-width apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, barra apoyada en la parte delantera de los hombros contra las clavículas, brazos cruzados al frente (o agarre olímpico), codos altos, pies al ancho de los hombros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, barre posée sur l'avant des épaules contre les clavicules, bras croisés devant (ou prise olympique), coudes hauts, pieds largeur d'épaules."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi, bilanciere appoggiato sulla parte anteriore delle spalle contro le clavicole, braccia incrociate davanti (o presa olimpica), gomiti alti, piedi alla larghezza delle spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立って、バーを肩の前の鎖骨に当てて乗せ、腕は前で交差(またはオリンピックグリップ)、ひじを高く、足は肩幅に。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé, barra apoiada na frente dos ombros junto às clavículas, braços cruzados à frente (ou pegada olímpica), cotovelos altos, pés na largura dos ombros."
          }
        }
      }
    },
    "Debout, bras tendus devant toi à hauteur des épaules, l'élastique dans les mains.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stehend, Arme vor dir auf Schulterhöhe gestreckt, Band in den Händen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing, arms straight in front of you at shoulder height, band in your hands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, brazos extendidos al frente a la altura de los hombros, banda elástica en las manos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, bras tendus devant toi à hauteur des épaules, l'élastique dans les mains."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi, braccia tese davanti a te all'altezza delle spalle, elastico tra le mani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立って、腕を肩の高さで前に伸ばし、バンドを両手で持った姿勢。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé, braços estendidos à frente na altura dos ombros, elástico nas mãos."
          }
        }
      }
    },
    "Debout, bras tendus, coudes près du buste.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stehend, Arme gestreckt, Ellbogen nah am Oberkörper."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing, arms straight, elbows close to your torso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, brazos extendidos, codos cerca del torso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, bras tendus, coudes près du buste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi, braccia tese, gomiti vicini al busto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕を伸ばして立ち、ひじは体の近くに。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé, braços esticados, cotovelos junto ao tronco."
          }
        }
      }
    },
    "Debout, buste droit, regard devant.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufrecht stehen, Oberkörper gerade, Blick nach vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand tall, torso upright, eyes forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, torso recto, mirada al frente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, buste droit, regard devant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi, busto dritto, sguardo avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立って、上体をまっすぐにし、視線は前に。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé, tronco reto, olhar à frente."
          }
        }
      }
    },
    "Debout, buste penché presque à l'horizontale, dos plat, bras collés au corps, coudes pliés à 90°.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stehend, Oberkörper fast waagerecht, Rücken gerade, Arme am Körper, Ellbogen 90° gebeugt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing, torso bent almost horizontal, flat back, arms tight to your body, elbows bent at 90°."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, torso inclinado casi horizontal, espalda recta, brazos pegados al cuerpo, codos doblados a 90°."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, buste penché presque à l'horizontale, dos plat, bras collés au corps, coudes pliés à 90°."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi, busto inclinato quasi in orizzontale, schiena piatta, braccia aderenti al corpo, gomiti piegati a 90°."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立って上体をほぼ水平に倒し、背中はまっすぐ、腕を体に付け、肘を90°に曲げた姿勢。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé, tronco inclinado quase na horizontal, costas retas, braços colados ao corpo, cotovelos dobrados a 90°."
          }
        }
      }
    },
    "Debout, buste penché presque à l'horizontale, dos plat, genoux fléchis, haltères sous les épaules.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
