    "Tends un bras derrière la tête et la jambe opposée près du sol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streck einen Arm hinter den Kopf und das gegenüberliegende Bein nah über den Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach one arm behind your head and the opposite leg out near the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estira un brazo por detrás de la cabeza y la pierna opuesta cerca del suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tends un bras derrière la tête et la jambe opposée près du sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allunga un braccio dietro la testa e la gamba opposta vicino al pavimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "片腕を頭の後ろへ、反対の脚を床すれすれに伸ばします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estique um braço atrás da cabeça e a perna oposta perto do chão."
          }
        }
      }
    },
    "Tends un bras devant toi et la jambe opposée derrière.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streck einen Arm nach vorn und das gegenüberliegende Bein nach hinten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach one arm out in front and the opposite leg behind you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estira un brazo al frente y la pierna opuesta hacia atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tends un bras devant toi et la jambe opposée derrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allunga un braccio davanti a te e la gamba opposta dietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "片腕を前に、反対の脚を後ろに伸ばします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estique um braço à frente e a perna oposta para trás."
          }
        }
      }
    },
