    "La jambe libre part vers l'arrière, bassin face au sol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das freie Bein geht nach hinten, Becken zeigt zum Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free leg goes back, hips facing the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pierna libre se va hacia atrás, caderas mirando al suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La jambe libre part vers l'arrière, bassin face au sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La gamba libera va all'indietro, bacino rivolto verso il pavimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "浮かせた脚を後ろに引き、骨盤は床に向けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A perna livre vai para trás, quadril virado para o chão."
          }
        }
      }
    },
    "La kettlebell monte près du corps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kettlebell steigt nah am Körper hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The kettlebell rises close to your body."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La kettlebell sube cerca del cuerpo."
          }
        },
