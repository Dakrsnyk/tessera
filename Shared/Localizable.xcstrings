    "À genoux face à la poulie haute, la corde tenue de chaque côté de la tête.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knie vor dem oberen Kabelzug, das Seil rechts und links vom Kopf halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kneel facing the high pulley, holding the rope on each side of your head."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De rodillas frente a la polea alta, sujeta la cuerda a cada lado de la cabeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À genoux face à la poulie haute, la corde tenue de chaque côté de la tête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ginocchio davanti al cavo alto, tieni la corda ai lati della testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイプーリーの方を向いてひざ立ちになり、ロープを頭の両側で持ちます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoelhe-se de frente para a polia alta, segurando a corda dos dois lados da cabeça."
          }
        }
      }
    },
    "À genoux sur un tapis, chevilles bloquées sous un appui, corps droit des genoux à la tête.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniend auf einer Matte, Knöchel unter einer Stütze fixiert, Körper gerade von Knien bis Kopf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kneeling on a mat, ankles anchored under a support, body straight from knees to head."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De rodillas sobre una colchoneta, tobillos sujetos bajo un apoyo, cuerpo recto de las rodillas a la cabeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À genoux sur un tapis, chevilles bloquées sous un appui, corps droit des genoux à la tête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ginocchio su un tappetino, caviglie bloccate sotto un appoggio, corpo dritto dalle ginocchia alla testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マットに膝立ちになり、足首を固定し、膝から頭まで体をまっすぐにした姿勢。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoelhado em um colchonete, tornozelos presos sob um apoio, corpo reto dos joelhos à cabeça."
          }
        }
      }
    },
    "À genoux, enroule le buste vers le sol, hanches fixes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniend, rolle den Oberkörper Richtung Boden ein, Hüfte bleibt fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kneeling, curl your torso toward the floor, hips fixed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De rodillas, enrolla el torso hacia el suelo, con las caderas fijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À genoux, enroule le buste vers le sol, hanches fixes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ginocchio, arrotola il busto verso il pavimento, fianchi fermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひざ立ちで、股関節は固定したまま上体を床に向けて丸めます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De joelhos, enrole o tronco em direção ao chão, quadris fixos."
          }
        }
      }
    },
    "À genoux, fesses vers les talons, bras allongés devant.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniend, Gesäß Richtung Fersen, Arme lang nach vorn gestreckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kneeling, hips toward your heels, arms stretched out in front."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De rodillas, glúteos hacia los talones, brazos estirados al frente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À genoux, fesses vers les talons, bras allongés devant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ginocchio, glutei verso i talloni, braccia distese davanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひざを付き、お尻をかかとに近づけ、腕を前に伸ばします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De joelhos, quadris em direção aos calcanhares, braços esticados à frente."
          }
        }
      }
    },
    "À genoux, gros orteils joints, genoux écartés ou serrés.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniend, große Zehen zusammen, Knie auseinander oder zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kneeling, big toes together, knees apart or together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De rodillas, dedos gordos de los pies juntos, rodillas separadas o juntas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À genoux, gros orteils joints, genoux écartés ou serrés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ginocchio, alluci uniti, ginocchia divaricate o unite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひざをつき、足の親指をつけて、ひざは開くか閉じます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De joelhos, dedões dos pés juntos, joelhos afastados ou juntos."
          }
        }
      }
    },
    "À genoux, mains sur la roue sous les épaules, dos neutre.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knie dich hin, Hände auf dem Rad unter den Schultern, Rücken neutral."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kneel with your hands on the wheel under your shoulders, back neutral."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte de rodillas, con las manos en la rueda bajo los hombros y la espalda neutra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À genoux, mains sur la roue sous les épaules, dos neutre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ginocchio, mani sulla ruota sotto le spalle, schiena neutra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひざ立ちになり、肩の下でローラーを握り、背中はニュートラルに。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoelhe-se, mãos na roda sob os ombros, costas neutras."
          }
        }
      }
    },
