    "%@ débités aujourd'hui pour 12 mois. Renouvellement automatique chaque année au même prix, annulable à tout moment.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heute für 12 Monate belastet. Verlängert sich automatisch jedes Jahr zum gleichen Preis, jederzeit kündbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ charged today for 12 months. Renews automatically every year at the same price; cancel anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cobrados hoy por 12 meses. Se renueva automáticamente cada año al mismo precio; cancélalo cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ débités aujourd'hui pour 12 mois. Renouvellement automatique chaque année au même prix, annulable à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ addebitati oggi per 12 mesi. Rinnovo automatico ogni anno allo stesso prezzo, annullabile in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日12か月分として%@が請求されます。毎年同じ価格で自動更新され、いつでもキャンセルできます。"
          }
        },
        "pt-BR": {
