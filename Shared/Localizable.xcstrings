    "Saute en poussant dans le sol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring und drück dich dabei vom Boden ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump by pushing off the floor."
