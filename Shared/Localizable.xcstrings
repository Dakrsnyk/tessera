            "state": "translated",
            "value": "Elige una categoría, el tamaño y tus widgets; luego «Personalizar» los abre en el Studio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un univers, la taille et tes widgets, puis « Personnaliser » les ouvre dans le Studio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una categoria, la dimensione e i tuoi widget, poi «Personalizza» li apre nello Studio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
