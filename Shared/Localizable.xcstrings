    "Amène le coude vers le bras d'appui.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe den Ellbogen zum Stützarm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your elbow toward your supporting arm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva el codo hacia el brazo de apoyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amène le coude vers le bras d'appui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta il gomito verso il braccio d'appoggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひじを支えている腕に近づけましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leve o cotovelo em direção ao braço de apoio."
          }
        }
      }
    },
    "Amène le coude vers le pied avant.": {
