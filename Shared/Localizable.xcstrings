          }
        }
      }
    },
    "Bras presque tendus au-dessus de la tête (debout face à la poulie, ou allongé en travers d'un banc).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arme fast gestreckt über dem Kopf (stehend vor dem Kabelzug oder quer auf einer Bank liegend)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arms almost straight overhead (standing facing the cable, or lying across a bench)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brazos casi extendidos sobre la cabeza (de pie frente a la polea, o acostado a lo largo de un banco)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bras presque tendus au-dessus de la tête (debout face à la poulie, ou allongé en travers d'un banc)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Braccia quasi tese sopra la testa (in piedi di fronte al cavo, o sdraiato trasversalmente su una panca)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕を頭上でほぼ伸ばしましょう(ケーブルの前に立つか、ベンチに横向きに寝ます)。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Braços quase esticados acima da cabeça (em pé de frente para a polia, ou deitado atravessado em um banco)."
          }
        }
      }
    },
    "Bras presque tendus devant la poitrine, coudes légèrement fléchis (allongé, assis ou à la poulie).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arme fast gestreckt vor der Brust, Ellbogen leicht gebeugt (liegend, sitzend oder am Kabelzug)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arms almost straight in front of your chest, elbows slightly bent (lying, seated or on a cable machine)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brazos casi estirados frente al pecho, codos ligeramente flexionados (tumbado, sentado o en polea)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bras presque tendus devant la poitrine, coudes légèrement fléchis (allongé, assis ou à la poulie)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Braccia quasi tese davanti al petto, gomiti leggermente flessi (sdraiato, seduto o ai cavi)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "胸の前で腕をほぼ伸ばし、ひじは軽く曲げます（仰向け、座位、またはケーブルで）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Braços quase esticados à frente do peito, cotovelos levemente flexionados (deitado, sentado ou na polia)."
          }
        }
      }
    },
    "Bras tendu au moment de l'impact, sans verrouiller.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arm im Moment des Treffers gestreckt, ohne ihn durchzudrücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arm extended at impact, without locking it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brazo estirado en el momento del impacto, sin bloquearlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bras tendu au moment de l'impact, sans verrouiller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Braccio teso al momento dell'impatto, senza bloccarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "当たる瞬間は腕を伸ばしますが、伸ばしきらないで。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Braço esticado no momento do impacto, sem travar."
          }
        }
      }
    },
    "Bras tendus devant toi, écarte l'élastique jusqu'à la poitrine.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arme vor dir gestreckt, zieh das Band bis zur Brust auseinander."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arms straight in front of you, pull the band apart to your chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brazos estirados frente a ti, separa la banda hasta el pecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bras tendus devant toi, écarte l'élastique jusqu'à la poitrine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Braccia tese davanti a te, allarga l'elastico fino al petto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕を前に伸ばし、バンドを胸まで左右に引き開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Braços esticados à sua frente, abra o elástico até o peito."
          }
        }
      }
    },
    "Bras tendus en bas, menton au-dessus de la barre en haut.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten Arme gestreckt, oben Kinn über der Stange."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arms straight at the bottom, chin over the bar at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brazos extendidos abajo, mentón sobre la barra arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bras tendus en bas, menton au-dessus de la barre en haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Braccia tese in basso, mento sopra la sbarra in alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下では腕を伸ばし、上ではあごをバーの上に。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Braços esticados embaixo, queixo acima da barra em cima."
          }
        }
      }
    },
