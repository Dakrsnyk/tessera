    "En fente avant, main opposée au sol à l'intérieur du pied avant.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Ausfallschritt nach vorn, gegenüberliegende Hand am Boden innen neben dem vorderen Fuß."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a forward lunge, opposite hand on the floor inside your front foot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En zancada hacia delante, mano contraria en el suelo, por dentro del pie adelantado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fente avant, main opposée au sol à l'intérieur du pied avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In affondo in avanti, mano opposta a terra all'interno del piede avanzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前に踏み出して、反対の手を前足の内側の床につきます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em avanço, mão oposta no chão, por dentro do pé da frente."
          }
        }
      }
    },
    "En fente, genou arrière au sol, avance doucement le bassin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Ausfallschritt, hinteres Knie am Boden, schiebe das Becken sanft nach vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a lunge, back knee on the floor, gently push your hips forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En zancada, con la rodilla trasera en el suelo, lleva la cadera suavemente hacia delante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fente, genou arrière au sol, avance doucement le bassin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In affondo, ginocchio posteriore a terra, porta dolcemente il bacino in avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランジの姿勢で後ろのひざを床に付け、骨盤をゆっくり前に出します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No afundo, joelho de trás no chão, leve o quadril suavemente para a frente."
          }
        }
      }
    },
    "En fente, genou arrière posé au sol, pied avant devant toi.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Ausfallschritt, hinteres Knie am Boden, vorderer Fuß vor dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a lunge, back knee on the floor, front foot in front of you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En zancada, rodilla trasera apoyada en el suelo, pie delantero frente a ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fente, genou arrière posé au sol, pied avant devant toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In affondo, ginocchio dietro appoggiato a terra, piede avanzato davanti a te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランジの姿勢で、後ろのひざを床につけ、前足は体の前に。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em avanço, joelho de trás apoiado no chão, pé da frente à sua frente."
          }
        }
      }
    },
    "En fente, main au sol, ouvre l'autre bras vers le plafond.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Ausfallschritt, Hand am Boden, öffne den anderen Arm zur Decke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a lunge, hand on the floor, open the other arm toward the ceiling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En zancada, con una mano en el suelo, abre el otro brazo hacia el techo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fente, main au sol, ouvre l'autre bras vers le plafond."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In affondo, mano a terra, apri l'altro braccio verso il soffitto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランジの姿勢で片手を床に付け、もう一方の腕を天井に向けて開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No afundo, mão no chão, abra o outro braço em direção ao teto."
          }
        }
      }
    },
    "En garde face au sac : pied avant devant, poings près du menton, genoux souples.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kampfhaltung vor dem Sack: vorderer Fuß vorn, Fäuste nah am Kinn, Knie locker."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fighting stance facing the bag: lead foot forward, fists near your chin, knees soft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En guardia frente al saco: pie adelantado delante, puños junto a la barbilla, rodillas flexibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En garde face au sac : pied avant devant, poings près du menton, genoux souples."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In guardia di fronte al sacco: piede anteriore avanti, pugni vicino al mento, ginocchia morbide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンドバッグの前で構えます。前足を前に、こぶしはあごの近く、ひざはやわらかく。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em guarda de frente para o saco: pé da frente adiantado, punhos perto do queixo, joelhos flexíveis."
          }
        }
      }
    },
