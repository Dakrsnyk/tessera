    "Idées générales tirées de la table d'aliments de Tessera, à adapter à tes goûts. Ce n'est pas un avis médical.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Allgemeine Ideen aus der Lebensmitteltabelle von Tessera, passe sie an deinen Geschmack an. Das ist keine medizinische Beratung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General ideas from Tessera's food table, to adapt to your taste. This isn't medical advice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideas generales tomadas de la tabla de alimentos de Tessera, para adaptar a tus gustos. No es un consejo médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idées générales tirées de la table d'aliments de Tessera, à adapter à tes goûts. Ce n'est pas un avis médical."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Idee generali tratte dalla tabella alimenti di Tessera, da adattare ai tuoi gusti. Non è un parere medico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesseraの食品データをもとにした一般的なアイデアです。好みに合わせて調整してください。医学的なアドバイスではありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideias gerais tiradas da tabela de alimentos do Tessera, para adaptar ao seu gosto. Não são aconselhamento médico."
          }
        }
      }
    },
    "Il affiche tes événements des 48 prochaines heures, directement depuis le calendrier de ton iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es zeigt deine Termine der nächsten 48 Stunden, direkt aus dem Kalender deines iPhones."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It shows your events for the next 48 hours, straight from your iPhone's calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tus eventos de las próximas 48 horas, directamente desde el calendario de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il affiche tes événements des 48 prochaines heures, directement depuis le calendrier de ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i tuoi eventi delle prossime 48 ore, direttamente dal calendario del tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後48時間の予定を、iPhoneのカレンダーから直接表示します。"
          }
