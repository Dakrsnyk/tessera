    "Limites habituelles des guides de santé publique, modifiables dans Objectifs. Quand un aliment ne donne pas une valeur, le total est marqué « partiel ».": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übliche Grenzwerte aus Leitlinien der öffentlichen Gesundheit, in Ziele änderbar. Liefert ein Lebensmittel keinen Wert, wird die Summe als „teilweise“ markiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usual limits from public health guidelines, editable in Goals. When a food doesn't give a value, the total is marked “partial”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límites habituales de las guías de salud pública, modificables en Objetivos. Cuando un alimento no aporta un valor, el total se marca como «parcial»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limites habituelles des guides de santé publique, modifiables dans Objectifs. Quand un aliment ne donne pas une valeur, le total est marqué « partiel »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiti abituali delle linee guida di sanità pubblica, modificabili in Obiettivi. Quando un alimento non fornisce un valore, il totale è segnato come «parziale»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公衆衛生ガイドラインの一般的な上限値で、「目標」で変更できます。値がない食品があると、合計には「一部」と表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limites habituais das diretrizes de saúde pública, editáveis em Metas. Quando um alimento não informa um valor, o total é marcado como “parcial”."
          }
        }
      }
    },
