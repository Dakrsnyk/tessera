        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele mostra seus eventos das próximas 48 horas, direto do calendário do seu iPhone."
          }
        }
      }
    },
    "Il ira dans « Mes repas » pour le reprendre d'une touche.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie landet in „Meine Mahlzeiten“, damit du sie mit einem Tipp wieder hinzufügen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It'll go in “My meals” so you can reuse it in one tap."
          }
        },
        "es": {
