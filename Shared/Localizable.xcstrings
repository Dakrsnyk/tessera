    "Bras et jambes juste au-dessus du sol, position fixe.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arme und Beine knapp über dem Boden, feste Position."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arms and legs just above the floor, holding still."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brazos y piernas justo sobre el suelo, posición fija."
          }
        },
