            "value": "Ses plages quittent l'horaire. Ses notes, examens et devoirs restent, sans cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue fasce escono dall'orario. Voti, esami e compiti restano, senza corso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間帯は時間割から外れます。成績、試験、課題は科目なしで残ります。"
