    "Redresse le buste, puis lève-toi ; redescends dans l'ordre inverse.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte den Oberkörper auf und steh auf; geh in umgekehrter Reihenfolge wieder runter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straighten your torso, then stand up; reverse the steps to go back down."
          }
