    "La force vient des hanches : les bras ne font que tenir la kettlebell.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kraft kommt aus der Hüfte: Die Arme halten nur die Kettlebell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The power comes from the hips: your arms just hold the kettlebell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuerza viene de las caderas: los brazos solo sostienen la kettlebell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La force vient des hanches : les bras ne font que tenir la kettlebell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La forza viene dai fianchi: le braccia tengono soltanto la kettlebell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "力は股関節から。腕はケトルベルを持つだけです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A força vem do quadril: os braços só seguram o kettlebell."
          }
        }
      }
    },
    "La force vient des hanches, les bras ne font que tenir.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kraft kommt aus der Hüfte, die Arme halten nur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The power comes from your hips; your arms just hold on."
          }
        },
        "es": {
