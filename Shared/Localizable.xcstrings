    "Garde les couleurs, le fond, la bordure, le texte, les icônes et la disposition de ce widget sous un nom, pour les donner à d'autres widgets.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert Farben, Hintergrund, Rahmen, Text, Symbole und Anordnung dieses Widgets unter einem Namen, damit du sie auf andere Widgets übertragen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps this widget's colors, background, border, text, icons and layout under a name, so you can give them to other widgets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda los colores, el fondo, el borde, el texto, los iconos y la disposición de este widget bajo un nombre, para aplicarlos a otros widgets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les couleurs, le fond, la bordure, le texte, les icônes et la disposition de ce widget sous un nom, pour les donner à d'autres widgets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva con un nome i colori, lo sfondo, il bordo, il testo, le icone e la disposizione di questo widget, per darli ad altri widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウィジェットの色、背景、枠線、テキスト、アイコン、レイアウトに名前を付けて保存し、他のウィジェットにも使えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda as cores, o fundo, a borda, o texto, os ícones e a disposição deste widget com um nome, para aplicá-los a outros widgets."
          }
        }
      }
    },
