    "« Maintenant » change selon le moment, et les analyses résument ta journée": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Jetzt“ ändert sich je nach Tageszeit, und die Auswertungen fassen deinen Tag zusammen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Now” adapts to the time of day, and insights sum up your day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Ahora” cambia según el momento del día, y los análisis resumen tu día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Maintenant » change selon le moment, et les analyses résument ta journée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Adesso» cambia in base al momento e le analisi riassumono la tua giornata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「いま」は時間帯に合わせて変わり、分析がその日をまとめます"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Agora” muda conforme o momento do dia, e as análises resumem o seu dia"
          }
        }
      }
    },
