    "Ajoute un voyage : compte à rebours, heure et météo sur place, vols, hébergements, programme, budget et liste des choses à ne pas oublier, au même endroit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine Reise hinzu: Countdown, Ortszeit und Wetter, Flüge, Unterkünfte, Programm, Budget und Packliste an einem Ort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a trip: countdown, local time and weather, flights, stays, itinerary, budget and a packing list, all in one place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un viaje: cuenta regresiva, hora y clima del destino, vuelos, alojamientos, programa, presupuesto y lista de cosas por llevar, todo en un solo lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un voyage : compte à rebours, heure et météo sur place, vols, hébergements, programme, budget et liste des choses à ne pas oublier, au même endroit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un viaggio: conto alla rovescia, ora e meteo del posto, voli, alloggi, programma, budget e lista delle cose da portare, tutto in un unico posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行を追加しましょう。カウントダウン、現地の時刻と天気、フライト、宿泊先、スケジュール、予算、持ち物リストをひとつにまとめられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma viagem: contagem regressiva, hora e clima no destino, voos, hospedagens, programação, orçamento e lista do que levar, tudo em um só lugar."
          }
        }
      }
    },
