    "Ta position n'a pas pu être trouvée. Réessaie ou cherche ta ville.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort konnte nicht gefunden werden. Versuche es erneut oder suche deine Stadt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location couldn't be found. Try again or search for your city."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo encontrar tu ubicación. Inténtalo de nuevo o busca tu ciudad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta position n'a pas pu être trouvée. Réessaie ou cherche ta ville."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile trovare la tua posizione. Riprova oppure cerca la tua città."
