    "Choisis les mini-apps à afficher : leur carte montre tes vraies données, et apparaît même vide pour t'inviter à les remplir.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Mini-Apps aus: Ihre Karte zeigt deine echten Daten und erscheint auch leer, um dich zum Ausfüllen einzuladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the mini-apps to show: their card shows your real data, and appears even when empty to invite you to fill it in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las miniapps que quieres ver: su tarjeta muestra tus datos reales y aparece aunque esté vacía para invitarte a completarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis les mini-apps à afficher : leur carte montre tes vraies données, et apparaît même vide pour t'inviter à les remplir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le mini-app da mostrare: la loro scheda mostra i tuoi dati reali e compare anche vuota per invitarti a compilarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示するミニアプリを選んでください。カードには実際のデータが表示され、空でも入力を促すために表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os miniapps a exibir: o cartão mostra seus dados reais e aparece mesmo vazio para convidar você a preenchê-lo."
          }
        }
      }
    },
