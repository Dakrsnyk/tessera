    "Choisis-en autant que tu veux. Tessera ne posera que les questions utiles, et tu pourras tout changer plus tard.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle so viele, wie du willst. Tessera stellt nur die nötigen Fragen, und du kannst später alles ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick as many as you like. Tessera will only ask the questions that matter, and you can change everything later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige todo lo que quieras. Tessera solo hará las preguntas útiles, y podrás cambiarlo todo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis-en autant que tu veux. Tessera ne posera que les questions utiles, et tu pourras tout changer plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegline quanti vuoi. Tessera farà solo le domande utili e potrai cambiare tutto più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつでも選べます。Tesseraは必要な質問だけをして、あとからすべて変更できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quantos quiser. O Tessera só fará as perguntas úteis, e você poderá mudar tudo depois."
          }
        }
      }
    },
