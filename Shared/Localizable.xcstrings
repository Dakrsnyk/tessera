    "À quatre pattes (ou debout face à la poulie), dos plat, ventre gainé.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Vierfüßlerstand (oder stehend vor dem Kabelzug), Rücken gerade, Bauch angespannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On all fours (or standing facing the cable), flat back, core braced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cuatro apoyos (o de pie frente a la polea), espalda plana, abdomen firme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quatre pattes (ou debout face à la poulie), dos plat, ventre gainé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A quattro zampe (o in piedi di fronte al cavo), schiena piatta, addome contratto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "四つんばい(またはケーブルの前に立ち)、背中は平らに、お腹に力を入れましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De quatro apoios (ou em pé de frente para a polia), costas retas, abdômen firme."
          }
        }
      }
    },
    "À quatre pattes, arrondis puis creuse doucement le dos au rythme de la respiration.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Vierfüßlerstand den Rücken im Atemrhythmus sanft runden und durchhängen lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On all fours, gently round then arch your back with your breathing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A cuatro patas, redondea y arquea suavemente la espalda al ritmo de la respiración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quatre pattes, arrondis puis creuse doucement le dos au rythme de la respiration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A quattro zampe, inarca e poi incava dolcemente la schiena seguendo il respiro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "四つ這いで、呼吸に合わせて背中をゆっくり丸めたり反らしたりします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em quatro apoios, arredonde e depois afunde suavemente as costas no ritmo da respiração."
          }
        }
      }
    },
    "À quatre pattes, genoux juste au-dessus du sol, avance main et pied opposés.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Vierfüßlerstand, Knie knapp über dem Boden, bewege Hand und gegenüberliegenden Fuß vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On all fours, knees just above the floor, move your opposite hand and foot forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A cuatro patas, con las rodillas justo sobre el suelo, avanza con la mano y el pie contrarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quatre pattes, genoux juste au-dessus du sol, avance main et pied opposés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A quattro zampe, ginocchia appena sopra il pavimento, avanza con mano e piede opposti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "四つ這いでひざを床すれすれに浮かせ、反対の手と足を前に出して進みます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em quatro apoios, joelhos pouco acima do chão, avance com a mão e o pé opostos."
          }
        }
      }
    },
    "À quatre pattes, lève le genou plié sur le côté, sans tourner le bassin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Vierfüßlerstand das gebeugte Knie seitlich anheben, ohne das Becken zu drehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On all fours, lift your bent knee out to the side without rotating your hips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A cuatro patas, levanta la rodilla flexionada hacia un lado, sin girar la cadera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quatre pattes, lève le genou plié sur le côté, sans tourner le bassin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A quattro zampe, solleva di lato il ginocchio piegato, senza ruotare il bacino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "四つ這いで、曲げたひざを横に上げます。骨盤は回しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em quatro apoios, levante o joelho dobrado para o lado, sem girar o quadril."
          }
        }
      }
    },
    "À quatre pattes, mains sous les épaules, genoux juste au-dessus du sol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Vierfüßlerstand, Hände unter den Schultern, Knie knapp über dem Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On all fours, hands under your shoulders, knees just above the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A cuatro patas, manos bajo los hombros, rodillas justo por encima del suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quatre pattes, mains sous les épaules, genoux juste au-dessus du sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A quattro zampe, mani sotto le spalle, ginocchia appena sopra il suolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "四つん這いになり、手は肩の下、ひざは床すれすれに構えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De quatro apoios, mãos sob os ombros, joelhos logo acima do chão."
          }
        }
      }
    },
    "À quatre pattes, mains sous les épaules, genoux sous les hanches, dos plat.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Vierfüßlerstand: Hände unter den Schultern, Knie unter den Hüften, Rücken gerade."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On all fours, hands under shoulders, knees under hips, back flat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A cuatro apoyos, manos bajo los hombros, rodillas bajo las caderas, espalda plana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quatre pattes, mains sous les épaules, genoux sous les hanches, dos plat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A quattro zampe, mani sotto le spalle, ginocchia sotto i fianchi, schiena piatta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "四つんばいになり、手は肩の下、ひざは股関節の下、背中はまっすぐにします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De quatro apoios, mãos sob os ombros, joelhos sob o quadril, costas retas."
          }
        }
      }
    },
    "À quatre pattes, mains sous les épaules, genoux sous les hanches.": {
