    "C'est acquis : même sans point sur les %@ %% qui restent, tu finis à %@ %% ou plus.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist sicher: Selbst ohne einen Punkt bei den verbleibenden %1$@ %% erreichst du %2$@ %% oder mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked in: even with zero points on the remaining %1$@%%, you'll finish at %2$@%% or more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está asegurado: aunque no sumes puntos en el %1$@ %% restante, terminas con %2$@ %% o más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est acquis : même sans point sur les %@ %% qui restent, tu finis à %@ %% ou plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È già sicuro: anche senza nessun punto sul restante %1$@%%, finisci al %2$@%% o più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確定です：残り%1$@%%で1点も取れなくても、%2$@%%以上で終えられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já está garantido: mesmo sem nenhum ponto nos %1$@%% restantes, você termina com %2$@%% ou mais."
          }
        }
      }
    },
