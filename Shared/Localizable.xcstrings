    "Descends doucement le buste vers l'avant sur les mains.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senke den Oberkörper sanft nach vorn auf die Hände."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gently lower your torso forward onto your hands."
          }
        },
