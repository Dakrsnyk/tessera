        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avance le genou avant vers le mur, au-dessus des orteils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta il ginocchio avanti verso il muro, sopra le dita dei piedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
