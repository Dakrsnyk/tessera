            "state": "translated",
            "value": "Irá a «Mis comidas» para repetirla con un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ira dans « Mes repas » pour le reprendre d'une touche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Andrà in «I miei pasti» per riprenderlo con un tocco."
          }
        },
        "ja": {
