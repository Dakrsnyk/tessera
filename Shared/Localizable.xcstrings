    "Rédigé par Apple Intelligence sur ton iPhone, uniquement à partir de tes données. Chaque chiffre est vérifié avant d'être affiché.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Apple Intelligence auf deinem iPhone verfasst, nur auf Basis deiner Daten. Jede Zahl wird vor der Anzeige geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Written by Apple Intelligence on your iPhone, only from your data. Every number is checked before it's shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redactado por Apple Intelligence en tu iPhone, únicamente a partir de tus datos. Cada cifra se verifica antes de mostrarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédigé par Apple Intelligence sur ton iPhone, uniquement à partir de tes données. Chaque chiffre est vérifié avant d'être affiché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scritto da Apple Intelligence sul tuo iPhone, solo a partire dai tuoi dati. Ogni numero viene verificato prima di essere mostrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
