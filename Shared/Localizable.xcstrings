    "Ton nom, ton anniversaire et tes centres d'intérêt restent sur ton iPhone. Tes autres informations (poids, objectifs, budget…) se modifient dans « Mes informations », sur l'accueil.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Name, dein Geburtstag und deine Interessen bleiben auf deinem iPhone. Deine übrigen Infos (Gewicht, Ziele, Budget …) bearbeitest du unter „Meine Infos“ auf dem Home-Bildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name, birthday and interests stay on your iPhone. Your other info (weight, goals, budget…) can be edited in “My info” on Home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre, tu cumpleaños y tus intereses se quedan en tu iPhone. El resto de tus datos (peso, objetivos, presupuesto…) se editan en «Mis datos», en Inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton nom, ton anniversaire et tes centres d'intérêt restent sur ton iPhone. Tes autres informations (poids, objectifs, budget…) se modifient dans « Mes informations », sur l'accueil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome, il tuo compleanno e i tuoi interessi restano sul tuo iPhone. Le altre informazioni (peso, obiettivi, budget…) si modificano in «Le mie info», nella Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前、誕生日、興味のあることはiPhoneの中に保存されます。ほかの情報(体重、目標、予算など)は、ホームの「マイ情報」で編集できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu nome, seu aniversário e seus interesses ficam no seu iPhone. Suas outras informações (peso, metas, orçamento…) são editadas em “Minhas informações”, no Início."
          }
        }
      }
    },
