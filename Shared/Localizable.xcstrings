    "À la bonne taille pour ton iPhone. Ensuite, dans Photos : Partager › « Utiliser en fond d'écran ».": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der passenden Größe für dein iPhone. Dann in Fotos: Teilen › „Als Hintergrundbild verwenden“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sized right for your iPhone. Then, in Photos: Share › “Use as Wallpaper”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el tamaño justo para tu iPhone. Después, en Fotos: Compartir › “Usar como fondo de pantalla”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la bonne taille pour ton iPhone. Ensuite, dans Photos : Partager › « Utiliser en fond d'écran »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella dimensione giusta per il tuo iPhone. Poi, in Foto: Condividi › «Usa come sfondo»."
          }
        },
        "ja": {
          "stringUnit": {
