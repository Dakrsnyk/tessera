    "Café, bus, lunch… Le widget Dépense rapide les note d'une touche.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaffee, Bus, Mittagessen … Das Widget Schnellausgabe trägt sie mit einem Tippen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coffee, bus, lunch… The Quick expense widget logs them in one tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Café, bus, almuerzo… El widget Gasto rápido los anota con un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Café, bus, lunch… Le widget Dépense rapide les note d'une touche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffè, bus, pranzo… Il widget Spesa rapida le registra con un tocco."
