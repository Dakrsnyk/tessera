            "value": "Manos en la pared para mantener el equilibrio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mains au mur pour l'équilibre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mani al muro per l'equilibrio."
          }
        },
        "ja": {
