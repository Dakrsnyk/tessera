    "Dans Photos, ouvre l'image, touche Partager puis « Utiliser en fond d'écran ».": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne das Bild in Fotos, tippe auf Teilen und dann auf „Als Hintergrundbild verwenden“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Photos, open the image, tap Share, then “Use as Wallpaper”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Fotos, abre la imagen, toca Compartir y luego “Usar como fondo de pantalla”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Photos, ouvre l'image, touche Partager puis « Utiliser en fond d'écran »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Foto, apri l'immagine, tocca Condividi e poi «Usa come sfondo»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「写真」でその画像を開き、共有をタップして「壁紙に設定」を選んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Fotos, abra a imagem, toque em Compartilhar e depois em “Usar como Papel de Parede”."
          }
        }
      }
    },
