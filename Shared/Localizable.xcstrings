    "Note tes dépenses dans Tessera, espace Budget.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse deine Ausgaben in Tessera im Bereich Budget."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log your expenses in the Budget space in Tessera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota tus gastos en el espacio Presupuesto de Tessera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note tes dépenses dans Tessera, espace Budget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota le tue spese in Tessera, nello spazio Budget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesseraの予算スペースで支出を記録しましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre seus gastos no Tessera, no espaço Orçamento."
          }
        }
      }
    },
    "Note tes pleins dans Tessera, espace Auto.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse deine Tankvorgänge in Tessera, Bereich Auto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log your fill-ups in Tessera, Car space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tus cargas de combustible en Tessera, espacio Auto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note tes pleins dans Tessera, espace Auto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra i tuoi rifornimenti in Tessera, spazio Auto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesseraの車スペースで給油を記録しましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre seus abastecimentos no Tessera, espaço Carro."
          }
        }
      }
    },
    "Note tes pleins et ton kilométrage : consommation, autonomie, coût réel par mois, entretiens et échéances se suivent tout seuls.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage deine Tankfüllungen und deinen Kilometerstand ein: Verbrauch, Reichweite, echte Monatskosten, Wartungen und Fälligkeiten verfolgen sich von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log your fill-ups and mileage: fuel economy, range, real monthly cost, maintenance and due dates track themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota tus cargas y tu kilometraje: el consumo, la autonomía, el costo real por mes, los mantenimientos y los vencimientos se siguen solos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note tes pleins et ton kilométrage : consommation, autonomie, coût réel par mois, entretiens et échéances se suivent tout seuls."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra i tuoi pieni e il chilometraggio: consumo, autonomia, costo reale al mese, tagliandi e scadenze si seguono da soli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "給油と走行距離を記録すると、燃費、航続距離、毎月の実コスト、メンテナンス、期限が自動で管理されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote seus abastecimentos e sua quilometragem: consumo, autonomia, custo real por mês, manutenções e vencimentos se acompanham sozinhos."
          }
        }
      }
    },
    "Note tes ventes (le total du jour suffit) et tes dépenses : chiffre d'affaires, bénéfice, panier moyen et comparaisons se calculent tout seuls.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage deine Verkäufe (die Tagessumme genügt) und deine Ausgaben ein: Umsatz, Gewinn, durchschnittlicher Warenkorb und Vergleiche berechnen sich von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log your sales (the day's total is enough) and your expenses: revenue, profit, average order value and comparisons work themselves out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota tus ventas (con el total del día basta) y tus gastos: ingresos, beneficio, ticket promedio y comparaciones se calculan solos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note tes ventes (le total du jour suffit) et tes dépenses : chiffre d'affaires, bénéfice, panier moyen et comparaisons se calculent tout seuls."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra le tue vendite (basta il totale del giorno) e le tue spese: fatturato, utile, scontrino medio e confronti si calcolano da soli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "販売（1日の合計だけでOK）と支出を記録すると、売上、利益、平均客単価、比較が自動で計算されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote suas vendas (o total do dia basta) e suas despesas: faturamento, lucro, ticket médio e comparações se calculam sozinhos."
          }
        }
      }
    },
    "Note tes ventes dans Tessera, espace Mon entreprise.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
