          }
        }
      }
    },
    "Ouvre lentement jusqu'à sentir l'étirement, sans dépasser la ligne des épaules.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne langsam, bis du die Dehnung spürst, nicht über die Schulterlinie hinaus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open slowly until you feel the stretch, without going past shoulder line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre despacio hasta sentir el estiramiento, sin pasar la línea de los hombros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre lentement jusqu'à sentir l'étirement, sans dépasser la ligne des épaules."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri lentamente fino a sentire lo stiramento, senza superare la linea delle spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレッチを感じるまでゆっくり開きます。肩のラインより後ろには行かないで。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra devagar até sentir o alongamento, sem passar da linha dos ombros."
          }
        }
      }
    },
    "Ouvre les bras en arc de cercle jusqu'à l'étirement des pectoraux (ou de l'arrière des épaules pour l'oiseau).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Arme im Bogen, bis du die Brust dehnst (oder die hintere Schulter beim Reverse Fly)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your arms in an arc until you feel a stretch in your chest (or the back of your shoulders for the reverse fly)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre los brazos en arco hasta sentir el estiramiento del pecho (o de la parte trasera de los hombros en el pájaro)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les bras en arc de cercle jusqu'à l'étirement des pectoraux (ou de l'arrière des épaules pour l'oiseau)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri le braccia ad arco fino a sentire lo stiramento dei pettorali (o della parte posteriore delle spalle per l'alzata posteriore)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "胸が伸びるまで（リアレイズ系では肩の後ろが伸びるまで）腕を弧を描くように開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra os braços em arco até alongar o peitoral (ou a parte de trás dos ombros no crucifixo inverso)."
          }
        }
      }
    },
