    "Glisse le long du mur jusqu'aux cuisses parallèles au sol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutsch an der Wand runter, bis die Oberschenkel parallel zum Boden sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide down the wall until your thighs are parallel to the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza la espalda por la pared hasta tener los muslos paralelos al suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse le long du mur jusqu'aux cuisses parallèles au sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scivola lungo il muro fino alle cosce parallele al pavimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "太ももが床と平行になるまで壁に沿って下がります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize pela parede até as coxas ficarem paralelas ao chão."
          }
        }
      }
    },
    "Glisse un aliment vers la gauche pour l'ajouter aux favoris. Le widget Ajout rapide les propose d'une touche.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisch ein Lebensmittel nach links, um es zu den Favoriten hinzuzufügen. Das Widget Schnell hinzufügen bietet sie mit einem Tippen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe a food left to add it to favorites. The Quick add widget offers them in one tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza un alimento a la izquierda para agregarlo a favoritos. El widget Agregar rápido los ofrece con un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse un aliment vers la gauche pour l'ajouter aux favoris. Le widget Ajout rapide les propose d'une touche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri un alimento verso sinistra per aggiungerlo ai preferiti. Il widget Aggiunta rapida li propone con un tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食品を左にスワイプしてお気に入りに追加しましょう。クイック追加ウィジェットからワンタップで追加できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize um alimento para a esquerda para adicioná-lo aos favoritos. O widget Adição rápida mostra todos a um toque."
          }
        }
      }
    },
    "Glisse vers la droite quand un entretien est fait : il repart du compteur d'aujourd'hui.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische nach rechts, wenn eine Wartung erledigt ist: Sie startet dann ab dem heutigen Kilometerstand neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe right when a service is done: it restarts from today's odometer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la derecha cuando se haga un mantenimiento: vuelve a empezar desde el odómetro de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse vers la droite quand un entretien est fait : il repart du compteur d'aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri verso destra quando una manutenzione è fatta: riparte dal contachilometri di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンテナンスを完了したら右にスワイプしてください。今日の走行距離から再スタートします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para a direita quando uma manutenção for feita: ela recomeça do odômetro de hoje."
          }
        }
      }
    },
