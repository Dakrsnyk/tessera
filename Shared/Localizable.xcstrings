    "Bras et jambes tendus au-dessus du sol, bas du dos plaqué ; tiens.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arme und Beine gestreckt über dem Boden, unterer Rücken am Boden; halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arms and legs extended above the floor, lower back pressed down; hold."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brazos y piernas estirados sobre el suelo, zona lumbar pegada; aguanta."
          }
        },
