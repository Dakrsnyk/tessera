    "Genou arrière au sol, face au mur, pied avant à une dizaine de centimètres du mur.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinteres Knie am Boden, zur Wand gewandt, vorderer Fuß etwa zehn Zentimeter von der Wand entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back knee on the floor, facing the wall, front foot about four inches from the wall."
          }
