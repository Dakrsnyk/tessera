    "Dix ambiances, chacune en clair et en sombre. Tu pourras en changer à tout moment dans Réglages.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zehn Stimmungen, jeweils hell und dunkel. Du kannst sie jederzeit in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten moods, each in light and dark. You can switch anytime in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diez ambientes, cada uno en claro y oscuro. Puedes cambiar en cualquier momento en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dix ambiances, chacune en clair et en sombre. Tu pourras en changer à tout moment dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieci atmosfere, ciascuna in chiaro e in scuro. Puoi cambiare in qualsiasi momento in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
