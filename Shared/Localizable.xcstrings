    "Un thème règle tout d'un coup : style, couleurs, fond et bordure. Ensuite, la couleur principale ou une palette (Couleurs) repeint tout le widget.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Thema stellt alles auf einmal ein: Stil, Farben, Hintergrund und Rahmen. Danach färbt die Hauptfarbe oder eine Palette (Farben) das ganze Widget neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A theme sets everything at once: style, colors, background and border. Then the main color or a palette (Colors) repaints the whole widget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tema ajusta todo de una vez: estilo, colores, fondo y borde. Después, el color principal o una paleta (Colores) repinta todo el widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un thème règle tout d'un coup : style, couleurs, fond et bordure. Ensuite, la couleur principale ou une palette (Couleurs) repeint tout le widget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tema imposta tutto in un colpo: stile, colori, sfondo e bordo. Poi il colore principale o una palette (Colori) ridipinge tutto il widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマはスタイル、色、背景、枠線をまとめて設定します。その後、メインカラーやパレット（カラー）でウィジェット全体の色を塗り替えられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um tema ajusta tudo de uma vez: estilo, cores, fundo e borda. Depois, a cor principal ou uma paleta (Cores) repinta todo o widget."
          }
        }
      }
    },
