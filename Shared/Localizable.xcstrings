    "%@. Renouvellement automatique chaque mois, annulable à tout moment. L'offre de bienvenue ne vaut qu'une fois par compte Apple.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Verlängert sich automatisch jeden Monat, jederzeit kündbar. Das Willkommensangebot gilt nur einmal pro Apple Account."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Renews automatically every month; cancel anytime. The welcome offer applies only once per Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Se renueva automáticamente cada mes; cancélalo cuando quieras. La oferta de bienvenida solo vale una vez por cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Renouvellement automatique chaque mois, annulable à tout moment. L'offre de bienvenue ne vaut qu'une fois par compte Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Rinnovo automatico ogni mese, annullabile in qualsiasi momento. L'offerta di benvenuto vale una sola volta per account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。毎月自動更新され、いつでもキャンセルできます。ウェルカムオファーはApple Accountごとに1回限りです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Renovação automática todo mês, cancelável a qualquer momento. A oferta de boas-vindas vale apenas uma vez por Conta Apple."
          }
        }
      }
    },
