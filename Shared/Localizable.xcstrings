    "\n\nRésume ces faits pour le widget « %@ ».": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nFasse diese Fakten für das Widget „%@“ zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nSummarize these facts for the widget “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nResume estos datos para el widget «%@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nRésume ces faits pour le widget « %@ »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nRiassumi questi fatti per il widget «%@»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n次の事実を、ウィジェット「%@」向けに要約してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nResuma estes fatos para o widget “%@”."
          }
        }
      }
    },
