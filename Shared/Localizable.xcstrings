    "Ses plages quittent l'horaire. Ses notes, examens et devoirs restent, sans cours.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Zeiten verschwinden aus dem Stundenplan. Noten, Prüfungen und Aufgaben bleiben erhalten, ohne Kurs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its time slots leave the schedule. Its grades, exams and assignments stay, without a course."
          }
        },
        "es": {
