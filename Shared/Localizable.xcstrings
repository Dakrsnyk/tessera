          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encontrar sua localização. Tente novamente ou busque sua cidade."
          }
        }
      }
    },
    "Ta position sert uniquement à trouver la météo. Elle n'est pas enregistrée ailleurs que sur ton iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort dient nur dazu, das Wetter zu finden. Er wird nirgendwo außer auf deinem iPhone gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is only used to find the weather. It isn't stored anywhere but on your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación solo se usa para encontrar el clima. No se guarda en ningún lugar que no sea tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta position sert uniquement à trouver la météo. Elle n'est pas enregistrée ailleurs que sur ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua posizione serve solo a trovare il meteo. Non viene salvata altrove che sul tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報は天気を調べるためだけに使われ、iPhone以外には保存されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua localização serve apenas para encontrar o clima. Ela não é guardada em nenhum lugar além do seu iPhone."
          }
        }
      }
    },
