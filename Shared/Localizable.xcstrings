            "value": "Lass leer, was du nicht weißt: Tessera kann es berechnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank what you don't know: Tessera can calculate it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja en blanco lo que no sepas: Tessera puede calcularlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse vide ce que tu ne sais pas : Tessera peut le calculer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto ciò che non sai: Tessera può calcolarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "わからない項目は空欄で大丈夫です。Tesseraが計算できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco o que não souber: o Tessera pode calcular."
          }
        }
      }
    },
