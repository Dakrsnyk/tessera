    "Un style change l'apparence et la composition : disposition, formes, texte, icônes, ombre. Tes couleurs restent.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Stil ändert Aussehen und Aufbau: Anordnung, Formen, Text, Symbole, Schatten. Deine Farben bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A style changes the look and layout: arrangement, shapes, text, icons, shadow. Your colors stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un estilo cambia la apariencia y la composición: disposición, formas, texto, iconos, sombra. Tus colores se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un style change l'apparence et la composition : disposition, formes, texte, icônes, ombre. Tes couleurs restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno stile cambia aspetto e composizione: disposizione, forme, testo, icone, ombra. I tuoi colori restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタイルは見た目と構成（レイアウト、形、テキスト、アイコン、影）を変えます。色はそのままです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um estilo muda a aparência e a composição: disposição, formas, texto, ícones, sombra. Suas cores permanecem."
          }
        }
      }
    },
    "Un tableau de bord de l'espace : un widget en grand, ou jusqu'à 4 widgets réunis.": {
