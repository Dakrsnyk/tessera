            "state": "translated",
            "value": "Levante o quadril."
          }
        }
      }
    },
    "Lève les jambes en gardant le bas du dos plaqué (ou jusqu'aux hanches à 90° suspendu).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb die Beine und halte den unteren Rücken am Boden (oder hängend bis die Hüfte 90° erreicht)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise your legs while keeping your lower back flat (or up to a 90° hip angle when hanging)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube las piernas manteniendo la zona lumbar pegada al suelo (o hasta las caderas a 90° si estás colgado)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève les jambes en gardant le bas du dos plaqué (ou jusqu'aux hanches à 90° suspendu)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solleva le gambe tenendo la parte bassa della schiena a terra (o fino ai fianchi a 90° se sei appeso)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腰を床につけたまま脚を上げます（ぶら下がる場合は股関節90°まで）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante as pernas mantendo a lombar colada no chão (ou até o quadril a 90° se estiver pendurado)."
          }
        }
      }
    },
