    "Le contenu de chaque widget ne change pas : seuls les couleurs, le fond, la bordure, le texte, les icônes et la disposition changent. Une photo de fond est gardée.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt jedes Widgets bleibt gleich: Nur Farben, Hintergrund, Rahmen, Text, Symbole und Anordnung ändern sich. Ein Hintergrundfoto bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content of each widget doesn't change: only the colors, background, border, text, icons and layout do. A background photo is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido de cada widget no cambia: solo cambian los colores, el fondo, el borde, el texto, los iconos y la disposición. Se conserva una foto de fondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu de chaque widget ne change pas : seuls les couleurs, le fond, la bordure, le texte, les icônes et la disposition changent. Une photo de fond est gardée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto di ogni widget non cambia: cambiano solo i colori, lo sfondo, il bordo, il testo, le icone e la disposizione. Una foto di sfondo viene mantenuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ウィジェットの内容は変わらず、色、背景、枠線、テキスト、アイコン、レイアウトだけが変わります。背景の写真はそのまま残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo de cada widget não muda: só mudam as cores, o fundo, a borda, o texto, os ícones e a disposição. Uma foto de fundo é mantida."
          }
        }
      }
    },
