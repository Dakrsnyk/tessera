            "value": "Von den geöffneten Armen auf Schulterhöhe bis zu den Händen zusammen vor der Brust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From arms open at shoulder level to hands together in front of your chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde los brazos abiertos a la altura de los hombros hasta las manos juntas frente al pecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des bras ouverts à la ligne des épaules jusqu'aux mains jointes devant la poitrine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalle braccia aperte all'altezza delle spalle fino alle mani unite davanti al petto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肩の高さで開いた腕から、胸の前で手が合わさるまで。"
          }
        },
