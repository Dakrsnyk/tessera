    "Avance le genou avant vers le mur, au-dessus des orteils.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiebe das vordere Knie zur Wand, über die Zehen."
          }
