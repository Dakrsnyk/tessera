    "Rien de grave : c'est la moyenne sur plusieurs jours qui compte. L'historique te la montre.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halb so schlimm: Entscheidend ist der Durchschnitt über mehrere Tage. Der Verlauf zeigt ihn dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No big deal: what counts is the average over several days. History shows it to you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pasa nada: lo que cuenta es el promedio de varios días. El historial te lo muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de grave : c'est la moyenne sur plusieurs jours qui compte. L'historique te la montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente di grave: conta la media su più giorni. La cronologia te la mostra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心配いりません。大切なのは数日間の平均です。履歴で確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem problema: o que conta é a média de vários dias. O histórico mostra isso."
          }
        }
      }
    },
