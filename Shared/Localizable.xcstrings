    "Sur l'écran verrouillé, appuie longuement puis touche « Personnaliser »": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte auf dem Sperrbildschirm gedrückt und tippe auf „Anpassen“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the Lock Screen, touch and hold, then tap “Customize”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la pantalla bloqueada, mantén pulsado y toca “Personalizar”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l'écran verrouillé, appuie longuement puis touche « Personnaliser »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella schermata di blocco, tieni premuto e tocca «Personalizza»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面を長押しして、「カスタマイズ」をタップします"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Tela Bloqueada, toque e segure e depois toque em “Personalizar”"
          }
        }
      }
    },
    "Sur l'écran verrouillé, touche et maintiens un espace vide, puis « Personnaliser ».": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte auf dem Sperrbildschirm eine freie Stelle gedrückt und tippe dann auf „Anpassen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the Lock Screen, touch and hold an empty area, then tap “Customize”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la pantalla bloqueada, mantén presionado un espacio vacío y luego toca “Personalizar”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l'écran verrouillé, touche et maintiens un espace vide, puis « Personnaliser »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulla schermata di blocco, tieni premuto uno spazio vuoto, poi tocca «Personalizza»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面で空いている場所を長押しし、「カスタマイズ」をタップします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Tela Bloqueada, toque e segure um espaço vazio e depois toque em “Personalizar”."
          }
        }
      }
    },
