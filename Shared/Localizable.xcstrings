    "Assis au bout d'un banc, jambes écartées, buste penché, l'arrière du bras contre l'intérieur de la cuisse.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Ende einer Bank sitzend, Beine gespreizt, Oberkörper vorgeneigt, Oberarmrückseite an der Innenseite des Oberschenkels."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitting at the end of a bench, legs apart, leaning forward, back of your arm against your inner thigh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado en la punta de un banco, piernas separadas, torso inclinado, parte trasera del brazo contra el interior del muslo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis au bout d'un banc, jambes écartées, buste penché, l'arrière du bras contre l'intérieur de la cuisse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seduto in fondo a una panca, gambe divaricate, busto inclinato, retro del braccio contro l'interno della coscia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベンチの端に座って脚を開き、上体を前傾させ、二の腕の裏を太ももの内側に当てた姿勢。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado na ponta de um banco, pernas afastadas, tronco inclinado, parte de trás do braço contra a parte interna da coxa."
          }
        }
      }
    },
    "Assis dans la machine, dos contre le dossier, coussins contre l'extérieur des genoux.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich ins Gerät, Rücken an der Lehne, Polster an der Außenseite der Knie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit in the machine, back against the pad, cushions against the outside of your knees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate en la máquina con la espalda contra el respaldo y las almohadillas en la parte exterior de las rodillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis dans la machine, dos contre le dossier, coussins contre l'extérieur des genoux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siediti nella macchina, schiena contro lo schienale, cuscinetti contro l'esterno delle ginocchia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンに座り、背中を背もたれにつけ、パッドをひざの外側に当てます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sente-se na máquina, costas no encosto, almofadas na parte externa dos joelhos."
          }
        }
      }
    },
    "Assis dans la machine, dos contre le dossier, coussins contre l'intérieur des genoux, jambes écartées.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich ins Gerät, Rücken an der Lehne, Polster an der Innenseite der Knie, Beine gespreizt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit in the machine, back against the pad, cushions against the inside of your knees, legs apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate en la máquina con la espalda contra el respaldo, las almohadillas en la parte interior de las rodillas y las piernas abiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis dans la machine, dos contre le dossier, coussins contre l'intérieur des genoux, jambes écartées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siediti nella macchina, schiena contro lo schienale, cuscinetti contro l'interno delle ginocchia, gambe aperte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンに座り、背中を背もたれにつけ、パッドをひざの内側に当てて脚を開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sente-se na máquina, costas no encosto, almofadas na parte interna dos joelhos, pernas abertas."
          }
        }
      }
    },
    "Assis dans la machine, dos plaqué au dossier, pieds largeur de hanches sur la plateforme.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzend im Gerät, Rücken an der Lehne, Füße hüftbreit auf der Plattform."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seated in the machine, back flat against the backrest, feet hip-width apart on the platform."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado en la máquina, espalda pegada al respaldo, pies al ancho de las caderas sobre la plataforma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis dans la machine, dos plaqué au dossier, pieds largeur de hanches sur la plateforme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seduto nella macchina, schiena aderente allo schienale, piedi alla larghezza del bacino sulla pedana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンに座り、背中を背もたれにつけ、足を腰幅にしてプラットフォームに置きましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado na máquina, costas coladas no encosto, pés na largura do quadril na plataforma."
          }
        }
      }
    },
    "Assis face à la machine, poitrine contre l'appui, bras tendus devant toi sur les poignées à hauteur des épaules.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzend mit Blick zur Maschine, Brust am Polster, Arme vor dir an den Griffen auf Schulterhöhe gestreckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitting facing the machine, chest against the pad, arms straight in front of you on the handles at shoulder height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado frente a la máquina, pecho contra el respaldo, brazos extendidos al frente en las manijas a la altura de los hombros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis face à la machine, poitrine contre l'appui, bras tendus devant toi sur les poignées à hauteur des épaules."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seduto di fronte alla macchina, petto contro l'appoggio, braccia tese davanti a te sulle maniglie all'altezza delle spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンに向かって座り、胸をパッドに当て、肩の高さのグリップを腕を伸ばして握った姿勢。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado de frente para a máquina, peito contra o apoio, braços estendidos à frente nas pegadas na altura dos ombros."
          }
        }
      }
    },
    "Assis ou debout, jambes tendues sans verrouiller les genoux.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzen oder stehen, Beine gestreckt, Knie nicht durchdrücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit or stand with legs straight, without locking your knees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado o de pie, piernas estiradas sin bloquear las rodillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis ou debout, jambes tendues sans verrouiller les genoux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seduto o in piedi, gambe tese senza bloccare le ginocchia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座るか立って、ひざをロックせずに脚を伸ばします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado ou em pé, pernas esticadas sem travar os joelhos."
          }
        }
      }
    },
    "Assis sur la machine, dos plaqué contre le dossier, poignées à hauteur des épaules, bras ouverts sur les côtés, coudes légèrement fléchis.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitze an der Maschine, Rücken fest an der Lehne, Griffe auf Schulterhöhe, Arme seitlich geöffnet, Ellbogen leicht gebeugt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit on the machine, back flat against the pad, handles at shoulder height, arms open to the sides, elbows slightly bent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado en la máquina, espalda pegada al respaldo, agarres a la altura de los hombros, brazos abiertos a los lados, codos ligeramente flexionados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis sur la machine, dos plaqué contre le dossier, poignées à hauteur des épaules, bras ouverts sur les côtés, coudes légèrement fléchis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seduto sulla macchina, schiena aderente allo schienale, maniglie all'altezza delle spalle, braccia aperte ai lati, gomiti leggermente piegati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンに座り、背中をシートにしっかり付け、グリップを肩の高さに合わせ、腕は横に開き、ひじは軽く曲げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado na máquina, costas coladas no encosto, pegadas na altura dos ombros, braços abertos para os lados, cotovelos levemente flexionados."
          }
        }
      }
    },
    "Assis sur le vélo, selle réglée pour une jambe presque tendue en bas.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Rad sitzen, Sattel so eingestellt, dass das Bein unten fast gestreckt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit on the bike, saddle set so your leg is almost straight at the bottom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado en la bici, con el sillín a una altura que deje la pierna casi estirada abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis sur le vélo, selle réglée pour une jambe presque tendue en bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seduto sulla bici, sella regolata in modo che la gamba sia quasi tesa in basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バイクに座り、ペダルが下にきたとき脚がほぼ伸びる高さにサドルを合わせます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado na bicicleta, com o selim regulado para a perna ficar quase esticada embaixo."
          }
        }
      }
    },
    "Assis sur un banc, avant-bras posés sur les cuisses, poignets dans le vide, barre en main paumes vers le haut.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einer Bank sitzend, Unterarme auf den Oberschenkeln, Handgelenke frei, Langhantel im Untergriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitting on a bench, forearms resting on your thighs, wrists over the edge, bar in hand, palms up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado en un banco, antebrazos sobre los muslos, muñecas en el aire, barra en las manos con las palmas hacia arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis sur un banc, avant-bras posés sur les cuisses, poignets dans le vide, barre en main paumes vers le haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seduto su una panca, avambracci appoggiati sulle cosce, polsi liberi, bilanciere in mano con i palmi in su."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベンチに座り、前腕を太ももに乗せて手首を外に出し、手のひらを上にしてバーを握った姿勢。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado em um banco, antebraços apoiados nas coxas, punhos para fora, barra nas mãos com as palmas para cima."
          }
        }
      }
    },
    "Assis à la machine, coussin sur le bas des cuisses, avant des pieds sur la marche.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich ans Gerät, Polster auf den unteren Oberschenkeln, Fußballen auf der Stufe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit at the machine, pad on your lower thighs, balls of your feet on the step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate en la máquina con la almohadilla sobre la parte baja de los muslos y la punta de los pies en el escalón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis à la machine, coussin sur le bas des cuisses, avant des pieds sur la marche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siediti alla macchina, cuscinetto sulla parte bassa delle cosce, avampiede sul gradino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンに座り、パッドを太ももの下側に乗せ、つま先側をステップに置きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sente-se na máquina, almofada na parte baixa das coxas, ponta dos pés no degrau."
          }
        }
      }
    },
    "Assis, coude appuyé contre l'intérieur de la cuisse.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzend, Ellbogen an die Innenseite des Oberschenkels gestützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seated, elbow braced against your inner thigh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, con el codo apoyado en la parte interna del muslo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis, coude appuyé contre l'intérieur de la cuisse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da seduto, gomito appoggiato all'interno della coscia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座って、ひじを太ももの内側に当てます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, com o cotovelo apoiado na parte interna da coxa."
          }
        }
      }
    },
    "Assis, dos contre le dossier, haltères à hauteur des oreilles au départ.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzen, Rücken an der Lehne, Kurzhanteln zu Beginn auf Ohrhöhe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit with your back against the pad, dumbbells at ear level to start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, con la espalda contra el respaldo y las mancuernas a la altura de las orejas al empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis, dos contre le dossier, haltères à hauteur des oreilles au départ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seduto, schiena contro lo schienale, manubri all'altezza delle orecchie in partenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背もたれに背中をつけて座り、スタートはダンベルを耳の高さに。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, costas apoiadas no encosto, halteres na altura das orelhas no início."
          }
        }
      }
    },
    "Assis, dos contre le dossier, rouleau sur le bas des tibias.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzend, Rücken an der Lehne, Polster auf den unteren Schienbeinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seated, back against the backrest, pad on your lower shins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, espalda contra el respaldo, rodillo sobre la parte baja de las espinillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis, dos contre le dossier, rouleau sur le bas des tibias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seduto, schiena contro lo schienale, rullo sulla parte bassa degli stinchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座って背中を背もたれにつけ、パッドをすねの下のほうに当てましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, costas no encosto, rolo na parte baixa das canelas."
          }
        }
      }
    },
    "Assis, genoux pliés, buste incliné en arrière (ou debout face à la poulie).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzen, Knie gebeugt, Oberkörper nach hinten geneigt (oder stehend vor dem Kabelzug)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit with knees bent, torso leaning back (or stand facing the cable machine)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, rodillas flexionadas y torso inclinado hacia atrás (o de pie frente a la polea)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis, genoux pliés, buste incliné en arrière (ou debout face à la poulie)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seduto, ginocchia piegate, busto inclinato all'indietro (o in piedi davanti ai cavi)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座ってひざを曲げ、上体を後ろに倒します（またはケーブルの前に立ちます）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, joelhos dobrados, tronco inclinado para trás (ou em pé de frente para a polia)."
          }
        }
      }
    },
    "Assis, pieds calés, dos droit, bras tendus vers la poignée.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzend, Füße abgestützt, Rücken gerade, Arme gestreckt zum Griff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seated, feet braced, back straight, arms extended toward the handle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, pies apoyados, espalda recta, brazos extendidos hacia el agarre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis, pieds calés, dos droit, bras tendus vers la poignée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seduto, piedi appoggiati, schiena dritta, braccia tese verso la maniglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座って足を固定し、背中は真っすぐ、腕はハンドルに向けて伸ばしましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, pés apoiados, costas retas, braços esticados em direção à pegada."
          }
        }
      }
    },
    "Assis, pieds sanglés, bras tendus, tibias verticaux.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzen, Füße fixiert, Arme gestreckt, Schienbeine senkrecht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit with your feet strapped in, arms straight, shins vertical."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, pies sujetos, brazos estirados y espinillas verticales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis, pieds sanglés, bras tendus, tibias verticaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seduto, piedi fissati, braccia tese, tibie verticali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座って足をストラップで固定し、腕を伸ばし、すねは垂直にします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, pés presos, braços esticados, canelas na vertical."
          }
        }
      }
    },
    "Assis, resserre les jambes contre la résistance, reviens lentement.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzend, schließe die Beine gegen den Widerstand, kehre langsam zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seated, squeeze your legs together against the resistance, return slowly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, junta las piernas contra la resistencia y vuelve despacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis, resserre les jambes contre la résistance, reviens lentement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da seduto, stringi le gambe contro la resistenza, torna lentamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座って、抵抗に逆らって脚を閉じ、ゆっくり戻します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, feche as pernas contra a resistência e volte devagar."
          }
        }
      }
    },
    "Assis, écarte les jambes contre la résistance, reviens lentement.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzend, spreize die Beine gegen den Widerstand, kehre langsam zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seated, push your legs apart against the resistance, return slowly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, abre las piernas contra la resistencia y vuelve despacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assis, écarte les jambes contre la résistance, reviens lentement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da seduto, allarga le gambe contro la resistenza, torna lentamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座って、抵抗に逆らって脚を開き、ゆっくり戻します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado, abra as pernas contra a resistência e volte devagar."
          }
        }
      }
    },
    "Assomption": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mariä Himmelfahrt"
          }
        },
        "en": {
          "stringUnit": {
