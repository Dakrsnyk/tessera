    "Aperçu avec des données d'exemple. Renseigne tes données ci-dessous : ton widget affichera les tiennes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau mit Beispieldaten. Gib unten deine Daten ein, dann zeigt dein Widget deine eigenen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview with sample data. Enter your data below and your widget will show yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa con datos de ejemplo. Introduce tus datos abajo y tu widget mostrará los tuyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu avec des données d'exemple. Renseigne tes données ci-dessous : ton widget affichera les tiennes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima con dati di esempio. Inserisci i tuoi dati qui sotto e il tuo widget mostrerà i tuoi."
