          "stringUnit": {
            "state": "translated",
            "value": "Bras bien posés sur le pupitre ; ne tends pas brutalement en bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Braccia ben appoggiate sul cuscino; non stenderle di colpo in basso."
