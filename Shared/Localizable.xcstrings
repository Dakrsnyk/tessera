    "Buste légèrement penché vers l'avant, coudes un peu écartés.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberkörper leicht nach vorn geneigt, Ellbogen etwas nach außen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Torso leaning slightly forward, elbows slightly flared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Torso ligeramente inclinado hacia delante, codos algo abiertos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buste légèrement penché vers l'avant, coudes un peu écartés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Busto leggermente inclinato in avanti, gomiti un po' aperti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上体を少し前に傾け、ひじは少し開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tronco levemente inclinado para a frente, cotovelos um pouco abertos."
          }
        }
      }
    },
    "Buste légèrement penché, pas plus.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberkörper leicht geneigt, nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Torso leaning slightly, no more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Torso ligeramente inclinado, no más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buste légèrement penché, pas plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Busto leggermente inclinato, non di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上体は少し傾ける程度に。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tronco levemente inclinado, não mais que isso."
          }
        }
      }
    },
    "Buste penché à environ 45°, dos droit, genoux légèrement fléchis, bras tendus sous les épaules.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberkörper etwa 45° nach vorn geneigt, Rücken gerade, Knie leicht gebeugt, Arme gestreckt unter den Schultern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Torso leaning about 45°, back straight, knees slightly bent, arms straight under your shoulders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Torso inclinado a unos 45°, espalda recta, rodillas ligeramente flexionadas, brazos extendidos bajo los hombros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buste penché à environ 45°, dos droit, genoux légèrement fléchis, bras tendus sous les épaules."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Busto inclinato di circa 45°, schiena dritta, ginocchia leggermente flesse, braccia tese sotto le spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上体を約45°前傾させ、背中は真っすぐ、ひざは軽く曲げ、腕は肩の真下で伸ばしましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tronco inclinado a cerca de 45°, costas retas, joelhos levemente flexionados, braços esticados sob os ombros."
          }
        }
      }
    },
    "Buste penché, bras collé au corps, tends l'avant-bras vers l'arrière.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberkörper vorgebeugt, Oberarm am Körper, strecke den Unterarm nach hinten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bent over, upper arm tight to your body, extend your forearm backward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el torso inclinado y el brazo pegado al cuerpo, extiende el antebrazo hacia atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buste penché, bras collé au corps, tends l'avant-bras vers l'arrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Busto inclinato, braccio aderente al corpo, estendi l'avambraccio all'indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上体を前に倒し、腕を体に付けたまま、前腕を後ろに伸ばします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o tronco inclinado e o braço colado ao corpo, estique o antebraço para trás."
          }
        }
      }
    },
    "Buste penché, ouvre les bras sur les côtés : c'est l'arrière de l'épaule qui travaille.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberkörper vorgebeugt, öffne die Arme zur Seite: Die hintere Schulter arbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bent over, open your arms out to the sides: the back of the shoulder does the work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el torso inclinado, abre los brazos hacia los lados: trabaja la parte trasera del hombro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buste penché, ouvre les bras sur les côtés : c'est l'arrière de l'épaule qui travaille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Busto inclinato, apri le braccia ai lati: lavora la parte posteriore della spalla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上体を前に倒し、腕を横に開きます。肩の後ろが働きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o tronco inclinado, abra os braços para os lados: é a parte de trás do ombro que trabalha."
          }
        }
      }
    },
