    "Ouvre le bras vers le plafond en tournant le buste.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne den Arm zur Decke und drehe dabei den Oberkörper."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your arm toward the ceiling, rotating your torso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el brazo hacia el techo girando el torso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le bras vers le plafond en tournant le buste."
          }
        },
