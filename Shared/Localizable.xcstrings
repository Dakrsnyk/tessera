    "Tessera lit tes pas, ta distance et tes étages depuis le capteur de ton iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera liest deine Schritte, deine Distanz und deine Etagen vom Sensor deines iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera reads your steps, distance and floors from your iPhone's sensor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera lee tus pasos, tu distancia y tus pisos desde el sensor de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera lit tes pas, ta distance et tes étages depuis le capteur de ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera legge i tuoi passi, la distanza e i piani dal sensore del tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesseraは、iPhoneのセンサーから歩数、距離、階数を読み取ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tessera lê seus passos, sua distância e seus andares pelo sensor do seu iPhone."
          }
        }
      }
    },
    "Tessera lit tes événements pour les afficher. Rien ne quitte ton iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera liest deine Termine, um sie anzuzeigen. Nichts verlässt dein iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera reads your events to show them. Nothing leaves your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera lee tus eventos para mostrarlos. Nada sale de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera lit tes événements pour les afficher. Rien ne quitte ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera legge i tuoi eventi per mostrarli. Nulla lascia il tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesseraは予定を読み取って表示します。データがiPhoneの外に出ることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tessera lê seus eventos para exibi-los. Nada sai do seu iPhone."
          }
        }
      }
    },
    "Tessera met ces thèmes en avant, sans jamais cacher les autres.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera hebt diese Themen hervor, ohne je die anderen auszublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera highlights these topics, without ever hiding the others."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera destaca estos temas, sin ocultar nunca los demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera met ces thèmes en avant, sans jamais cacher les autres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera mette in evidenza questi temi, senza mai nascondere gli altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesseraはこれらのテーマを優先して表示します。ほかのテーマが隠れることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tessera destaca esses temas, sem nunca esconder os outros."
          }
        }
      }
    },
    "Tessera n'a pas accès à Photos. Autorise l'ajout de photos dans Réglages › Tessera › Photos.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera hat keinen Zugriff auf Fotos. Erlaube das Hinzufügen von Fotos unter Einstellungen › Tessera › Fotos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera can't access Photos. Allow adding photos in Settings › Tessera › Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera no tiene acceso a Fotos. Permite añadir fotos en Ajustes › Tessera › Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera n'a pas accès à Photos. Autorise l'ajout de photos dans Réglages › Tessera › Photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera non ha accesso a Foto. Consenti l'aggiunta di foto in Impostazioni › Tessera › Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesseraは写真にアクセスできません。「設定」›「Tessera」›「写真」で写真の追加を許可してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tessera não tem acesso a Fotos. Permita adicionar fotos em Ajustes › Tessera › Fotos."
          }
        }
      }
    },
    "Tessera ne demande l'autorisation qu'au moment où tu actives un rappel. Les comptes à rebours ont leur propre rappel dans l'éditeur.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera fragt erst um Erlaubnis, wenn du eine Erinnerung aktivierst. Countdowns haben im Editor ihre eigene Erinnerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera only asks for permission when you turn on a reminder. Countdowns have their own reminder in the editor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera solo pide permiso cuando activas un recordatorio. Las cuentas regresivas tienen su propio recordatorio en el editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera ne demande l'autorisation qu'au moment où tu actives un rappel. Les comptes à rebours ont leur propre rappel dans l'éditeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera chiede l'autorizzazione solo quando attivi un promemoria. I conti alla rovescia hanno il proprio promemoria nell'editor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesseraは、リマインダーをオンにしたときだけ許可を求めます。カウントダウンのリマインダーは、エディタで個別に設定できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tessera só pede autorização quando você ativa um lembrete. As contagens regressivas têm seu próprio lembrete no editor."
          }
        }
      }
    },
    "Tessera ne se connecte à aucune banque : tout vient de ce que tu notes. Ce sont des repères, pas des conseils financiers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera verbindet sich mit keiner Bank: Alles stammt aus deinen Einträgen. Das sind Richtwerte, keine Finanzberatung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera doesn't connect to any bank: everything comes from what you log. These are guides, not financial advice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera no se conecta a ningún banco: todo viene de lo que anotas. Son referencias, no consejos financieros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera ne se connecte à aucune banque : tout vient de ce que tu notes. Ce sont des repères, pas des conseils financiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera non si collega a nessuna banca: tutto viene da ciò che registri. Sono riferimenti, non consigli finanziari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesseraは銀行に接続しません。すべてあなたの記録から計算されます。これは目安であり、金融アドバイスではありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera não se conecta a nenhum banco: tudo vem do que você anota. São referências, não conselhos financeiros."
          }
        }
      }
    },
