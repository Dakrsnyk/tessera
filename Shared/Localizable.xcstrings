    "Saute vers le haut, bras au-dessus de la tête, et reçois-toi souplement.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring hoch, Arme über dem Kopf, und lande weich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump up with your arms overhead and land softly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta hacia arriba con los brazos sobre la cabeza y aterriza con suavidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saute vers le haut, bras au-dessus de la tête, et reçois-toi souplement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta in alto con le braccia sopra la testa e atterra con morbidezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕を頭上に伸ばして真上にジャンプし、やわらかく着地します。"
