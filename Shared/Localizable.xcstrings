    "Du sol aux épaules.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Boden zu den Schultern."
          }
        },
        "en": {
          "stringUnit": {
