    "Loyer, électricité, Internet, abonnements : Tessera te rappelle la prochaine date et le total par mois.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miete, Strom, Internet, Abos: Tessera erinnert dich an das nächste Datum und die Summe pro Monat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rent, electricity, internet, subscriptions: Tessera reminds you of the next date and the monthly total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alquiler, electricidad, internet, suscripciones: Tessera te recuerda la próxima fecha y el total por mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loyer, électricité, Internet, abonnements : Tessera te rappelle la prochaine date et le total par mois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Affitto, elettricità, Internet, abbonamenti: Tessera ti ricorda la prossima data e il totale al mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家賃、電気、インターネット、サブスク。次の期日と月の合計をTesseraがお知らせします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aluguel, luz, internet, assinaturas: Tessera lembra a próxima data e o total por mês."
          }
        }
      }
    },
