        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal busto verso il pavimento fino al corpo allineato, senza inarcare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上体を床に向けた位置から体が一直線になるまで。腰は反らさずに。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tronco em direção ao chão até o corpo alinhado, sem arquear."
          }
        }
      }
    },
    "Du coude plié à 90° jusqu'au bras tendu.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom 90° gebeugten Ellbogen bis zum gestreckten Arm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From elbow bent at 90° to straight arm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Del codo flexionado a 90° hasta el brazo extendido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du coude plié à 90° jusqu'au bras tendu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal gomito piegato a 90° fino al braccio teso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひじを90°に曲げた状態から、腕が伸びるまで。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Do cotovelo dobrado a 90° até o braço esticado."
          }
        }
      }
    },
    "Du pied au sol jusqu'à debout sur le banc.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Fuß am Boden bis zum Stand auf der Bank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From foot on the floor to standing on the bench."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Del pie en el suelo a estar de pie sobre el banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du pied au sol jusqu'à debout sur le banc."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal piede a terra fino a in piedi sulla panca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "床に足がある状態から、ベンチの上に立つまで。"
          }
        },
        "pt-BR": {
