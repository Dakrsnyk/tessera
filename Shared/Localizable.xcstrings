            "value": "Debout, pieds un peu plus larges que les épaules, pointes ouvertes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi, piedi un po' più larghi delle spalle, punte in fuori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立って、足は肩幅より少し広く、つま先は外向きに。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé, pés um pouco mais afastados que os ombros, pontas dos pés para fora."
          }
        }
      }
    },
    "Debout, stable, bras le long du corps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabil stehen, Arme seitlich am Körper."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand steady, arms at your sides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, estable, con los brazos a los lados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, stable, bras le long du corps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi, stabile, braccia lungo il corpo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立って安定し、腕は体の横に。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé, estável, braços ao lado do corpo."
          }
        }
      }
    },
    "Debout, un haltère tenu à deux mains au-dessus de la tête, bras tendus.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stehend, eine Kurzhantel mit beiden Händen über dem Kopf, Arme gestreckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing, one dumbbell held overhead with both hands, arms straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, una mancuerna sujeta con ambas manos sobre la cabeza, brazos extendidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, un haltère tenu à deux mains au-dessus de la tête, bras tendus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi, un manubrio tenuto con due mani sopra la testa, braccia tese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立って、ダンベル1つを両手で頭上に持ち、腕を伸ばした姿勢。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé, um halter seguro com as duas mãos acima da cabeça, braços estendidos."
          }
        }
      }
    },
    "Debout, une charge lourde dans chaque main.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufrecht stehen, in jeder Hand ein schweres Gewicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand with a heavy weight in each hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, con una carga pesada en cada mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, une charge lourde dans chaque main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi, un peso pesante in ogni mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立って、両手に重めの重りを持ちます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé, com uma carga pesada em cada mão."
          }
        }
      }
    },
    "Debout, échauffé, espace dégagé autour de toi.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stehend, aufgewärmt, mit freiem Platz um dich herum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing, warmed up, with clear space around you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, con calentamiento hecho y espacio libre a tu alrededor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, échauffé, espace dégagé autour de toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi, riscaldato, con spazio libero intorno a te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立って、ウォームアップは済ませ、周りに十分なスペースを確保します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé, aquecido, com espaço livre ao seu redor."
          }
        }
      }
    },
