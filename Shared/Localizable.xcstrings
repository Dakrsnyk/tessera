            "value": "Vor der Wand, schiebe das Knie zur Wand, ohne die Ferse zu heben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Facing a wall, drive your knee toward the wall without lifting your heel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De frente a la pared, lleva la rodilla hacia la pared sin levantar el talón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face au mur, avance le genou vers le mur sans décoller le talon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di fronte al muro, porta il ginocchio verso il muro senza staccare il tallone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁に向かい、かかとを浮かせずにひざを壁に近づけます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De frente para a parede, leve o joelho em direção à parede sem tirar o calcanhar do chão."
          }
        }
      }
    },
