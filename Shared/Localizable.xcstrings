    "Jambe avant pliée devant toi, jambe arrière allongée, buste qui descend doucement.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorderes Bein vor dir gebeugt, hinteres Bein gestreckt, Oberkörper senkt sich langsam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Front leg bent in front of you, back leg extended, torso slowly lowering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierna delantera flexionada al frente, pierna trasera estirada, torso bajando despacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jambe avant pliée devant toi, jambe arrière allongée, buste qui descend doucement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamba anteriore piegata davanti a te, gamba posteriore distesa, busto che scende dolcemente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の脚を曲げて体の前に置き、後ろの脚は伸ばして、上体をゆっくり下ろします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perna da frente dobrada à sua frente, perna de trás esticada, tronco descendo devagar."
          }
        }
      }
    },
    "Jambe d'appui droite sans verrouiller.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standbein gerade, aber nicht durchgedrückt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing leg straight without locking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierna de apoyo recta sin bloquear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jambe d'appui droite sans verrouiller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamba d'appoggio dritta senza bloccarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軸脚は伸ばし、ひざはロックしない。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perna de apoio reta, sem travar."
          }
        }
      }
    },
