    "Buste droit pour les triceps, légèrement penché pour les pectoraux.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberkörper aufrecht für den Trizeps, leicht nach vorn geneigt für die Brust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upright torso for triceps, slight forward lean for chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Torso recto para los tríceps, ligeramente inclinado para los pectorales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buste droit pour les triceps, légèrement penché pour les pectoraux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Busto dritto per i tricipiti, leggermente inclinato per i pettorali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上体は、上腕三頭筋には真っすぐ、胸には少し前傾で。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tronco reto para o tríceps, levemente inclinado para o peitoral."
          }
        }
      }
    },
    "Buste droit, coudes serrés vers l'arrière.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberkörper aufrecht, Ellbogen eng nach hinten."
