    "Passe la jambe tendue sous toi pour poser le genou.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh das gestreckte Bein unter dir durch und setz das Knie ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweep your straight leg under you and set the knee down."
          }
