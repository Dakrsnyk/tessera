        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Busto dritto, gomiti stretti all'indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上体はまっすぐ、ひじは後ろにしぼります。"
