          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The barcode is saved: the next scan will find this food."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de barras se guarda: el próximo escaneo encontrará este alimento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code-barres est retenu : le prochain scan retrouvera cet aliment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice a barre viene salvato: la prossima scansione troverà questo alimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーコードは保存されます。次回のスキャンでこの食品が見つかります。"
