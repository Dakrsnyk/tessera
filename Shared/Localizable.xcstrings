    "30 jours, ou la période de ton choix, avec tes moyennes et ton poids. Tes repas restent enregistrés : tout s'affiche dès que tu passes à Premium.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "30 Tage oder ein Zeitraum deiner Wahl, mit deinen Durchschnittswerten und deinem Gewicht. Deine Mahlzeiten bleiben gespeichert: Alles erscheint, sobald du zu Premium wechselst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30 days, or the period of your choice, with your averages and your weight. Your meals stay saved: everything shows as soon as you go Premium."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "30 días, o el periodo que elijas, con tus promedios y tu peso. Tus comidas siguen guardadas: todo aparece en cuanto te pases a Premium."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 jours, ou la période de ton choix, avec tes moyennes et ton poids. Tes repas restent enregistrés : tout s'affiche dès que tu passes à Premium."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "30 giorni, o il periodo che preferisci, con le tue medie e il tuo peso. I tuoi pasti restano salvati: tutto compare appena passi a Premium."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日間、または好きな期間の平均と体重。食事の記録は保存されたままで、Premiumにするとすぐにすべて表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "30 dias, ou o período que você escolher, com suas médias e seu peso. Suas refeições continuam salvas: tudo aparece assim que você passar para o Premium."
          }
        }
      }
    },
