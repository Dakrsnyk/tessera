          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salte empurrando o chão."
          }
        }
      }
    },
    "Saute en écartant les pieds et lève les bras au-dessus de la tête.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Springe mit gegrätschten Beinen und hebe die Arme über den Kopf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump while spreading your feet and raise your arms overhead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta abriendo las piernas y levanta los brazos por encima de la cabeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saute en écartant les pieds et lève les bras au-dessus de la tête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta divaricando i piedi e alza le braccia sopra la testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "足を開きながらジャンプし、腕を頭の上に上げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pule abrindo os pés e levante os braços acima da cabeça."
          }
        }
      }
    },
    "Saute juste assez haut pour la laisser passer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Springe nur so hoch, dass das Seil durchkommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump just high enough to let it pass."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta solo lo justo para que pase la cuerda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saute juste assez haut pour la laisser passer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta solo quanto basta per farla passare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロープが通るだけの高さでジャンプしましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pule só o suficiente para a corda passar."
          }
        }
      }
    },
    "Saute les pieds en arrière en planche.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring mit den Füßen nach hinten in die Plank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump your feet back into a plank."
          }
        },
        "es": {
