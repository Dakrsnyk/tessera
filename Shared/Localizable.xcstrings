    "Monte jusqu'au menton au-dessus de la barre (ou la barre au haut de la poitrine).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe dich hoch, bis das Kinn über der Stange ist (oder die Stange die obere Brust berührt)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull up until your chin is over the bar (or the bar reaches your upper chest)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube hasta que el mentón pase la barra (o la barra llegue a la parte alta del pecho)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte jusqu'au menton au-dessus de la barre (ou la barre au haut de la poitrine)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sali fino a portare il mento sopra la sbarra (o la sbarra all'altezza della parte alta del petto)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あごがバーを越えるまで上がりましょう(またはバーを胸の上部まで引き寄せます)。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba até o queixo passar da barra (ou a barra chegar à parte alta do peito)."
          }
        }
      }
    },
    "Monte jusqu'aux bras à hauteur des épaules.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb an, bis die Arme auf Schulterhöhe sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise until your arms are at shoulder height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube hasta tener los brazos a la altura de los hombros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte jusqu'aux bras à hauteur des épaules."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sali fino alle braccia all'altezza delle spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕が肩の高さに来るまで上げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba até os braços ficarem na altura dos ombros."
          }
        }
      }
    },
    "Monte jusqu'à la cuisse dans l'alignement du dos.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb das Bein, bis der Oberschenkel in einer Linie mit dem Rücken ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift until your thigh is in line with your back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube hasta que el muslo quede alineado con la espalda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte jusqu'à la cuisse dans l'alignement du dos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sali finché la coscia è allineata alla schiena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "太ももが背中と一直線になるまで上げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba até a coxa ficar alinhada com as costas."
          }
        }
      }
    },
    "Monte jusqu'à la cuisse presque horizontale.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb es, bis der Oberschenkel fast waagerecht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift until your thigh is almost horizontal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube hasta que el muslo quede casi horizontal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte jusqu'à la cuisse presque horizontale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sali finché la coscia è quasi orizzontale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "太ももがほぼ水平になるまで上げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba até a coxa ficar quase na horizontal."
          }
        }
      }
    },
    "Monte la charge le long du corps jusqu'au bas de la poitrine, coudes vers l'extérieur.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh das Gewicht am Körper entlang bis zur unteren Brust, Ellbogen nach außen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the weight up along your body to the lower chest, elbows out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube la carga pegada al cuerpo hasta la parte baja del pecho, con los codos hacia fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte la charge le long du corps jusqu'au bas de la poitrine, coudes vers l'extérieur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta il carico lungo il corpo fino alla parte bassa del petto, gomiti verso l'esterno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重りを体に沿って胸の下まで引き上げ、ひじは外に向けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba a carga rente ao corpo até a parte baixa do peito, cotovelos para fora."
          }
        }
      }
    },
    "Monte le bâton au-dessus de la tête, bras tendus.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebe den Stab mit gestreckten Armen über den Kopf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise the stick over your head, arms straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube el palo por encima de la cabeza, con los brazos estirados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte le bâton au-dessus de la tête, bras tendus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta il bastone sopra la testa, braccia tese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕を伸ばしたまま、スティックを頭の上に上げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba o bastão acima da cabeça, braços esticados."
          }
        }
      }
    },
    "Monte les hanches jusqu'à aligner tout le corps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb die Hüften, bis der ganze Körper eine Linie bildet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift your hips until your whole body is in line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube las caderas hasta alinear todo el cuerpo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte les hanches jusqu'à aligner tout le corps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza i fianchi fino ad allineare tutto il corpo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体全体が一直線になるまで腰を持ち上げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante o quadril até alinhar o corpo todo."
          }
        }
      }
    },
    "Monte sur la pointe des pieds le plus haut possible.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe so hoch wie möglich auf die Zehenspitzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rise onto your toes as high as you can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube sobre la punta de los pies lo más alto posible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte sur la pointe des pieds le plus haut possible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sali sulle punte il più in alto possibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "できるだけ高くつま先立ちになりましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba na ponta dos pés o mais alto possível."
          }
