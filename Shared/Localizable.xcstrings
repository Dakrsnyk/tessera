    "À quatre pattes, tends un bras et la jambe opposée, dos plat.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Vierfüßlerstand einen Arm und das gegenüberliegende Bein strecken, Rücken gerade."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On all fours, extend one arm and the opposite leg, back flat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A cuatro patas, estira un brazo y la pierna contraria, espalda recta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quatre pattes, tends un bras et la jambe opposée, dos plat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A quattro zampe, estendi un braccio e la gamba opposta, schiena piatta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "四つ這いで、片腕と反対の脚を伸ばします。背中は平らに。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em quatro apoios, estique um braço e a perna oposta, costas retas."
          }
        }
      }
    },
