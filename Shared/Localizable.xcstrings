    "Lance une session de 15, 25 ou 50 minutes directement depuis le widget. Le minuteur défile en direct sur ton écran d'accueil.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte direkt im Widget eine Sitzung von 15, 25 oder 50 Minuten. Der Timer läuft live auf deinem Home-Bildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a 15, 25 or 50-minute session right from the widget. The timer runs live on your Home Screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una sesión de 15, 25 o 50 minutos directamente desde el widget. El temporizador avanza en vivo en tu pantalla de inicio."
          }
