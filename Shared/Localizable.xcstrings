          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé, tronco inclinado quase na horizontal, costas retas, joelhos flexionados, halteres abaixo dos ombros."
          }
        }
      }
    },
    "Debout, bâton tenu à deux mains en prise large devant les cuisses, bras tendus.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stehend, Stab mit beiden Händen im weiten Griff vor den Oberschenkeln, Arme gestreckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing, holding a stick with both hands in a wide grip in front of your thighs, arms straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, palo sujeto con las dos manos en agarre ancho delante de los muslos, brazos estirados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, bâton tenu à deux mains en prise large devant les cuisses, bras tendus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi, bastone tenuto a due mani con presa larga davanti alle cosce, braccia tese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立って、スティックを広めの握りで両手で持ち、太ももの前で腕を伸ばします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé, bastão seguro com as duas mãos em pegada larga na frente das coxas, braços esticados."
          }
        }
      }
    },
    "Debout, charge devant les cuisses, bras presque tendus.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufrecht stehen, Gewicht vor den Oberschenkeln, Arme fast gestreckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand with the weight in front of your thighs, arms almost straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, con la carga frente a los muslos y los brazos casi estirados."
          }
        },
        "fr": {
          "stringUnit": {
