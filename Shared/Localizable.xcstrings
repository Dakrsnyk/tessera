    "Tant que le bas du dos ne se creuse pas.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange der untere Rücken nicht ins Hohlkreuz geht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As long as your lower back doesn't arch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras la zona lumbar no se arquee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que le bas du dos ne se creuse pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché la zona lombare non si inarca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腰が反らない範囲で。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde que a lombar não arqueie."
          }
        }
      }
    },
    "Tant que le bas du dos reste collé au dossier.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange der untere Rücken an der Lehne bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As long as your lower back stays against the backrest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras la zona lumbar siga pegada al respaldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que le bas du dos reste collé au dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché la zona lombare resta aderente allo schienale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腰が背もたれから離れない範囲で。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto a lombar continuar colada no encosto."
          }
        }
      }
    },
    "Tant que le bas du dos reste plaqué au sol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange der untere Rücken am Boden bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As long as your lower back stays pressed to the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras la zona lumbar siga pegada al suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que le bas du dos reste plaqué au sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché la zona lombare resta schiacciata a terra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腰が床についている範囲で。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde que a lombar fique colada no chão."
          }
