    "Avant-bras contre un encadrement de porte, avance doucement le buste.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterarm an einen Türrahmen legen, schiebe den Oberkörper sanft nach vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forearm against a door frame, gently lean your torso forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antebrazo contra el marco de una puerta, adelanta el torso con suavidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant-bras contre un encadrement de porte, avance doucement le buste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avambraccio contro lo stipite di una porta, porta dolcemente il busto in avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドア枠に前腕を当て、上体をゆっくり前に出します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antebraço contra o batente de uma porta, leve o tronco suavemente para a frente."
          }
        }
      }
    },
    "Avant-bras posés sur les cuisses, seuls les poignets bougent.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterarme auf den Oberschenkeln, nur die Handgelenke bewegen sich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forearms resting on your thighs, only your wrists move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antebrazos apoyados en los muslos, solo se mueven las muñecas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant-bras posés sur les cuisses, seuls les poignets bougent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avambracci appoggiati sulle cosce, si muovono solo i polsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前腕を太ももに乗せ、手首だけを動かします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antebraços apoiados nas coxas, só os punhos se movem."
          }
        }
      }
    },
    "Avec ton objectif, Tessera te dit ce qu'il te reste et te propose des idées de repas.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deinem Ziel sagt dir Tessera, was dir noch bleibt, und schlägt dir Mahlzeiten vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a goal, Tessera tells you what's left and suggests meal ideas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con tu objetivo, Tessera te dice cuánto te queda y te propone ideas de comidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec ton objectif, Tessera te dit ce qu'il te reste et te propose des idées de repas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con il tuo obiettivo, Tessera ti dice cosa ti resta e ti propone idee per i pasti."
          }
        },
        "ja": {
