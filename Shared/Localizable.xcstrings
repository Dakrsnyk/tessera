            "state": "translated",
            "value": "Indica tu objetivo de calorías en Tessera para saber cuánto te queda por comida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne ton objectif calorique dans Tessera pour savoir ce qu'il te reste par repas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
