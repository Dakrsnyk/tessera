    "Chaque paiement compte dans tes dépenses et dans sa catégorie, à sa date.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zahlung zählt zu deinen Ausgaben und zu ihrer Kategorie, an ihrem Datum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each payment counts in your expenses and in its category, on its date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pago cuenta en tus gastos y en su categoría, en su fecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque paiement compte dans tes dépenses et dans sa catégorie, à sa date."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni pagamento conta nelle tue spese e nella sua categoria, alla sua data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いはそれぞれの日付で、支出とそのカテゴリに計上されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pagamento conta nas suas despesas e na categoria dele, na data dele."
          }
        }
      }
    },
