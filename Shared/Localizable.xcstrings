    "Supprimer un cours retire aussi ses plages de l'horaire ; ses notes, examens et devoirs restent.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Löschen eines Kurses verschwinden auch seine Zeiten aus dem Stundenplan; Noten, Prüfungen und Aufgaben bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting a course also removes its time slots from the schedule; its grades, exams and assignments stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar un curso también quita sus bloques del horario; sus notas, exámenes y tareas se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer un cours retire aussi ses plages de l'horaire ; ses notes, examens et devoirs restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare un corso toglie anche le sue fasce dall'orario; voti, esami e compiti restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "科目を削除すると、時間割からその時間帯も削除されます。成績、試験、課題は残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir uma disciplina também remove os horários dela; as notas, provas e trabalhos continuam."
          }
        }
      }
    },
