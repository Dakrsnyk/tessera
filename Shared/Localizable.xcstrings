          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your calorie goal or scan a meal: your calories for the day will show up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica tu objetivo de calorías o escanea una comida: tus calorías del día aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne ton objectif calorique ou scanne un repas : tes calories du jour apparaîtront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica il tuo obiettivo calorico o scansiona un pasto: le tue calorie del giorno appariranno qui."
          }
