    "Direct du bras arrière en tournant la hanche, puis retour en garde.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade mit dem hinteren Arm unter Drehung der Hüfte, dann zurück in die Deckung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rear-hand cross, rotating your hip, then back to guard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Directo con el brazo trasero girando la cadera, y vuelta a la guardia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct du bras arrière en tournant la hanche, puis retour en garde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diretto col braccio arretrato ruotando l'anca, poi ritorno in guardia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腰をひねって後ろ手でストレート、そして構えに戻ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Direto com o braço de trás girando o quadril, depois volta para a guarda."
          }
        }
      }
    },
    "Direct du bras avant, puis retour en garde.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade mit dem vorderen Arm, dann zurück in die Deckung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lead-hand jab, then back to guard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Directo con el brazo delantero y vuelta a la guardia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct du bras avant, puis retour en garde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diretto col braccio avanzato, poi ritorno in guardia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前手でジャブ、そして構えに戻ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Direto com o braço da frente, depois volta para a guarda."
          }
        }
      }
    },
    "Dis ce qui t'intéresse : tes widgets et « Mon Quotidien » reprendront tes objectifs, ton programme, ton budget… sans que tu aies à les répéter.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag uns, was dich interessiert: Deine Widgets und „Mein Tag“ übernehmen deine Ziele, deinen Trainingsplan, dein Budget… ohne dass du sie wiederholen musst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us what you're into: your widgets and “My Day” will pick up your goals, your training program, your budget… without you having to repeat them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos qué te interesa: tus widgets y «Mi día» retomarán tus objetivos, tu programa, tu presupuesto… sin que tengas que repetirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis ce qui t'intéresse : tes widgets et « Mon Quotidien » reprendront tes objectifs, ton programme, ton budget… sans que tu aies à les répéter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicci cosa ti interessa: i tuoi widget e «La mia giornata» useranno i tuoi obiettivi, il tuo programma, il tuo budget… senza che tu debba ripeterli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "興味のあることを教えてください。ウィジェットと「マイデイ」が、目標、トレーニングプログラム、予算などを引き継ぐので、何度も入力する必要はありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga o que te interessa: seus widgets e o “Meu dia” vão usar suas metas, seu programa de treino, seu orçamento… sem você precisar repetir."
          }
        }
      }
    },
