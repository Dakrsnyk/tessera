    "Saisis tes soldes à la main : Tessera ne se connecte à aucune banque.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deine Kontostände von Hand ein: Tessera verbindet sich mit keiner Bank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your balances by hand: Tessera doesn't connect to any bank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa tus saldos a mano: Tessera no se conecta a ningún banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis tes soldes à la main : Tessera ne se connecte à aucune banque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci i tuoi saldi a mano: Tessera non si collega a nessuna banca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高は手動で入力してください。Tesseraは銀行に接続しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite seus saldos manualmente: Tessera não se conecta a nenhum banco."
          }
        }
      }
    },
    "Saisis tes soldes à la main : Tessera ne se connecte à aucune banque. Touche un compte pour le modifier ou le supprimer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deine Kontostände von Hand ein: Tessera verbindet sich mit keiner Bank. Tippe auf ein Konto, um es zu ändern oder zu löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your balances by hand: Tessera doesn't connect to any bank. Tap an account to edit or delete it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tus saldos a mano: Tessera no se conecta a ningún banco. Toca una cuenta para modificarla o eliminarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis tes soldes à la main : Tessera ne se connecte à aucune banque. Touche un compte pour le modifier ou le supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci i saldi a mano: Tessera non si collega a nessuna banca. Tocca un conto per modificarlo o eliminarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高は手入力です。Tesseraはどの銀行にも接続しません。口座をタップすると編集・削除できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe seus saldos manualmente: o Tessera não se conecta a nenhum banco. Toque em uma conta para editá-la ou excluí-la."
          }
        }
      }
    },
