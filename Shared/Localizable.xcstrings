    "Sur le banc à 45°, hanches sur l'appui, chevilles bloquées sous les rouleaux, corps aligné, bras croisés.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der 45°-Bank, Hüften auf der Auflage, Knöchel unter den Rollen fixiert, Körper in einer Linie, Arme verschränkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the 45° bench, hips on the pad, ankles locked under the rollers, body in line, arms crossed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el banco a 45°, caderas sobre el apoyo, tobillos bajo los rodillos, cuerpo alineado y brazos cruzados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le banc à 45°, hanches sur l'appui, chevilles bloquées sous les rouleaux, corps aligné, bras croisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulla panca a 45°, fianchi sull'appoggio, caviglie bloccate sotto i rulli, corpo allineato, braccia incrociate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "45度のベンチで腰をパッドに乗せ、足首をローラーの下に固定し、体を一直線にして腕を組みます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No banco a 45°, quadril no apoio, tornozelos presos sob os rolos, corpo alinhado, braços cruzados."
          }
        }
      }
    },
