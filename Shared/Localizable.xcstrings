    "Cafés, pompes, pages lues… Le widget Compteur ajoute d'une touche.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaffees, Liegestütze, gelesene Seiten … Das Widget Zähler zählt mit einem Tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coffees, push-ups, pages read… The Counter widget adds them in one tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafés, flexiones, páginas leídas… El widget Contador suma con un toque."
