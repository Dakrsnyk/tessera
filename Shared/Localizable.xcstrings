    "Abaisse d'abord les épaules, puis tire les coudes vers le bas et l'arrière.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senke zuerst die Schultern, dann ziehe die Ellbogen nach unten und hinten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower your shoulders first, then pull your elbows down and back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero baja los hombros, luego lleva los codos hacia abajo y atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaisse d'abord les épaules, puis tire les coudes vers le bas et l'arrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassa prima le spalle, poi tira i gomiti verso il basso e indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず肩を下げ、次にひじを下と後ろに引きましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro abaixe os ombros, depois puxe os cotovelos para baixo e para trás."
          }
        }
      }
    },
    "Abaisse la barre en arc de cercle jusqu'aux cuisses, bras tendus.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh die Stange mit gestreckten Armen im Bogen bis zu den Oberschenkeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the bar down in an arc to your thighs, arms straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja la barra en arco hasta los muslos, brazos extendidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaisse la barre en arc de cercle jusqu'aux cuisses, bras tendus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassa la barra ad arco fino alle cosce, braccia tese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕を伸ばしたまま、弧を描くようにバーを太ももまで下ろします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixe a barra em arco até as coxas, braços estendidos."
          }
        }
      }
    },
    "Abaisse les bras en arc de cercle jusqu'aux hanches (ou au-dessus de la poitrine).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senke die Arme im Bogen bis zu den Hüften (oder über die Brust)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower your arms in an arc to your hips (or over your chest)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja los brazos en arco hasta las caderas (o sobre el pecho)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaisse les bras en arc de cercle jusqu'aux hanches (ou au-dessus de la poitrine)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassa le braccia ad arco fino ai fianchi (o sopra il petto)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕を弧を描くように腰まで(または胸の上まで)下ろしましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixe os braços em arco até os quadris (ou acima do peito)."
          }
        }
      }
    },
    "Abaisse légèrement les épaules pour les engager.": {
