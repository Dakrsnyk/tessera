    "Amène les mains l'une vers l'autre devant le bas de la poitrine en arc de cercle.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe die Hände in einem Bogen vor dem unteren Brustbereich zueinander."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your hands toward each other in front of your lower chest in an arc."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca las manos entre sí frente a la parte baja del pecho en arco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amène les mains l'une vers l'autre devant le bas de la poitrine en arc de cercle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta le mani l'una verso l'altra davanti alla parte bassa del petto in un arco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "胸の下のあたりの前で、弧を描くように両手を近づけます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leve as mãos uma em direção à outra na frente da parte baixa do peito em arco."
          }
        }
      }
    },
