    "Tes widgets, tâches, habitudes et montants seront supprimés. Ton abonnement n'est pas touché.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Widgets, Aufgaben, Gewohnheiten und Beträge werden gelöscht. Dein Abo bleibt unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your widgets, tasks, habits and amounts will be deleted. Your subscription isn't affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán tus widgets, tareas, hábitos y montos. Tu suscripción no se ve afectada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes widgets, tâches, habitudes et montants seront supprimés. Ton abonnement n'est pas touché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi widget, attività, abitudini e importi verranno eliminati. Il tuo abbonamento non cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェット、タスク、習慣、金額が削除されます。サブスクリプションには影響しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus widgets, tarefas, hábitos e valores serão apagados. Sua assinatura não é afetada."
          }
        }
      }
    },
