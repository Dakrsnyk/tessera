        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance une session de 15, 25 ou 50 minutes directement depuis le widget. Le minuteur défile en direct sur ton écran d'accueil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia una sessione di 15, 25 o 50 minuti direttamente dal widget. Il timer scorre in tempo reale sulla tua schermata Home."
