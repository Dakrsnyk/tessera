          "stringUnit": {
            "state": "translated",
            "value": "Manos a la anchura de los hombros, codos cerca del cuerpo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mains largeur d'épaules, coudes près du corps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mani larghe quanto le spalle, gomiti vicino al corpo."
          }
        },
        "ja": {
          "stringUnit": {
