          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上体をひねりながら、腕を天井に向けて開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o braço em direção ao teto, girando o tronco."
          }
        }
      }
    },
    "Ouvre le coude vers le plafond en tournant le haut du dos.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne den Ellbogen zur Decke und drehe dabei den oberen Rücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your elbow toward the ceiling, rotating your upper back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el codo hacia el techo girando la parte alta de la espalda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le coude vers le plafond en tournant le haut du dos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il gomito verso il soffitto ruotando la parte alta della schiena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背中の上部をひねりながら、ひじを天井に向けて開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
