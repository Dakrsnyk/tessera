    "Ajoute les incontournables (passeport, chargeur, assurance…) sans doublon ; retire ceux qui ne te servent pas en glissant.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt die Must-haves (Reisepass, Ladegerät, Versicherung …) ohne Duplikate hinzu; wische, um nicht benötigte zu entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds the must-haves (passport, charger, insurance…) with no duplicates; swipe to remove the ones you don't need."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade lo imprescindible (pasaporte, cargador, seguro…) sin duplicados; quita lo que no necesites deslizando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute les incontournables (passeport, chargeur, assurance…) sans doublon ; retire ceux qui ne te servent pas en glissant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge gli indispensabili (passaporto, caricabatterie, assicurazione…) senza doppioni; rimuovi quelli che non ti servono scorrendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスポート、充電器、保険などの定番を重複なく追加します。不要なものはスワイプで削除できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona os itens indispensáveis (passaporte, carregador, seguro…) sem duplicar; remova os que não precisar deslizando."
          }
        }
      }
    },
