    "Modifié ici, c'est modifié partout : « Mes informations », tes widgets et « Mon Quotidien ».": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du hier änderst, gilt überall: „Meine Infos“, deine Widgets und „Mein Tag“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change it here, change it everywhere: “My info”, your widgets and “My Day”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que cambias aquí cambia en todas partes: «Mis datos», tus widgets y «Mi día»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifié ici, c'est modifié partout : « Mes informations », tes widgets et « Mon Quotidien »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia qui, cambia ovunque: «Le mie info», i tuoi widget e «La mia giornata»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで変更すれば、すべてに反映されます：「マイ情報」、ウィジェット、「マイデイ」。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterou aqui, alterou em todo lugar: “Minhas informações”, seus widgets e “Meu dia”."
          }
        }
      }
    },
