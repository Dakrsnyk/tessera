    "Compté dans les dépenses de Finances et dans sa catégorie à cette date, puis à chaque échéance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird an diesem Datum und danach bei jeder Fälligkeit zu den Ausgaben in Finanzen und zu seiner Kategorie gezählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted in Finances expenses and in its category on this date, then on each due date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cuenta en los gastos de Finanzas y en su categoría en esta fecha, y luego en cada vencimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compté dans les dépenses de Finances et dans sa catégorie à cette date, puis à chaque échéance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteggiato nelle spese di Finanze e nella sua categoria in questa data, poi a ogni scadenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日付と以降の各支払日に、ファイナンスの支出とそのカテゴリに計上されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contado nas despesas de Finanças e na categoria dele nesta data, depois a cada vencimento."
          }
        }
      }
    },
