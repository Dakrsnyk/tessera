    "Automatique : Tessera met d'abord ce qui compte maintenant (repas, séance du jour, cours…), selon ce que tu as renseigné.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch: Tessera zeigt zuerst, was jetzt zählt (Mahlzeiten, heutiges Training, Kurse…), je nach deinen Angaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic: Tessera puts what matters now first (meals, today's workout, classes…), based on what you entered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático: Tessera pone primero lo que importa ahora (comidas, entrenamiento del día, clases…), según lo que registraste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique : Tessera met d'abord ce qui compte maintenant (repas, séance du jour, cours…), selon ce que tu as renseigné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatico: Tessera mette prima ciò che conta adesso (pasti, allenamento di oggi, lezioni…), in base a ciò che hai inserito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動：入力した内容に応じて、今大切なもの（食事、今日のワークアウト、授業など）を先に表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático: o Tessera mostra primeiro o que importa agora (refeições, treino do dia, aulas…), conforme o que você registrou."
          }
        }
      }
    },
