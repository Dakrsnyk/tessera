    "Ce que tu te permets de dépenser chaque mois, factures comprises ou non : à toi de choisir, Tessera compte ce que tu notes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du dir pro Monat an Ausgaben erlaubst, mit oder ohne Rechnungen: Du entscheidest, Tessera zählt, was du einträgst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you allow yourself to spend each month, bills included or not: your call, Tessera counts what you log."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que te permites gastar cada mes, con facturas o sin ellas: tú eliges, Tessera cuenta lo que anotas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu te permets de dépenser chaque mois, factures comprises ou non : à toi de choisir, Tessera compte ce que tu notes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto ti permetti di spendere ogni mese, fatture incluse o no: scegli tu, Tessera conta quello che registri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月使ってよい金額です。請求書を含めるかどうかは自由。Tesseraは、あなたが記録したものを集計します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quanto você se permite gastar por mês, com faturas incluídas ou não: você escolhe, Tessera conta o que você anota."
          }
        }
      }
    },
