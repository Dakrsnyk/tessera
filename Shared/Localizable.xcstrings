    "Tant que le dos reste droit : c'est la hanche qui bouge, pas le dos.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange der Rücken gerade bleibt: Die Hüfte bewegt sich, nicht der Rücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As long as your back stays straight: the hips move, not your back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras la espalda se mantenga recta: la que se mueve es la cadera, no la espalda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que le dos reste droit : c'est la hanche qui bouge, pas le dos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché la schiena resta dritta: si muove l'anca, non la schiena."
