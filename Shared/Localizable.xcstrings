    "Abonnés, devis envoyés, avis clients, NPS… Crée les indicateurs qui comptent pour toi et note leur valeur quand tu veux : Tessera trace leur évolution.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnenten, gesendete Angebote, Kundenbewertungen, NPS… Lege die Kennzahlen an, die für dich zählen, und trage ihren Wert ein, wann du willst: Tessera zeichnet ihre Entwicklung auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribers, quotes sent, customer reviews, NPS… Create the metrics that matter to you and log their value whenever you like: Tessera charts how they change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscriptores, cotizaciones enviadas, reseñas de clientes, NPS… Crea los indicadores que te importan y anota su valor cuando quieras: Tessera traza su evolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnés, devis envoyés, avis clients, NPS… Crée les indicateurs qui comptent pour toi et note leur valeur quand tu veux : Tessera trace leur évolution."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbonati, preventivi inviati, recensioni dei clienti, NPS… Crea gli indicatori che contano per te e registra il loro valore quando vuoi: Tessera traccia la loro evoluzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購読者、送付した見積もり、顧客レビュー、NPS…。大切な指標を作って、好きなタイミングで値を記録すると、Tesseraが推移をグラフにします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assinantes, orçamentos enviados, avaliações de clientes, NPS… Crie os indicadores que importam para você e anote o valor quando quiser: Tessera traça a evolução deles."
          }
        }
      }
    },
