        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach heute etwas, auf das du morgen stolz bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do one thing today that you'll be proud of tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz hoy algo de lo que estés orgulloso mañana."
