    "Ton achat est en attente d'approbation. Premium s'activera dès qu'il sera validé.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Genehmigung. Premium wird aktiviert, sobald er bestätigt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase is awaiting approval. Premium will activate as soon as it's approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de aprobación. Premium se activará en cuanto se valide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton achat est en attente d'approbation. Premium s'activera dès qu'il sera validé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in attesa di approvazione. Premium si attiverà non appena sarà convalidato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。承認されると、Premiumが有効になります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra está aguardando aprovação. O Premium será ativado assim que ela for validada."
          }
        }
      }
    },
