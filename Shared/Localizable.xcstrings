    "Si tu vends des abonnements, note ton revenu mensuel récurrent chaque mois : Tessera en suit la croissance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Abos verkaufst, trage jeden Monat deinen monatlich wiederkehrenden Umsatz ein: Tessera verfolgt das Wachstum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you sell subscriptions, log your monthly recurring revenue each month: Tessera tracks its growth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vendes suscripciones, anota cada mes tu ingreso mensual recurrente: Tessera sigue su crecimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu vends des abonnements, note ton revenu mensuel récurrent chaque mois : Tessera en suit la croissance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vendi abbonamenti, registra ogni mese il tuo ricavo mensile ricorrente: Tessera ne segue la crescita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクを販売している場合は、毎月の月次経常収益を記録してください。Tesseraが成長を追跡します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você vende assinaturas, anote todo mês sua receita mensal recorrente: Tessera acompanha o crescimento."
          }
        }
      }
    },
