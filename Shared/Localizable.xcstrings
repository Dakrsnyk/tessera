    "Choisis un modèle dans le Store, personnalise-le et enregistre-le. Il apparaîtra ici.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle im Store eine Vorlage, passe sie an und speichere sie. Sie erscheint dann hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a template in the Store, customize it and save it. It will show up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una plantilla en la Tienda, personalízala y guárdala. Aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un modèle dans le Store, personnalise-le et enregistre-le. Il apparaîtra ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un modello nello Store, personalizzalo e salvalo. Apparirà qui."
