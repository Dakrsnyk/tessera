    "Calculé sur ton iPhone à partir de tes données, sans jamais inventer de chiffre. Avec Apple Intelligence (iOS 26), le texte est reformulé plus naturellement.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem iPhone aus deinen Daten berechnet, ohne jemals eine Zahl zu erfinden. Mit Apple Intelligence (iOS 26) wird der Text natürlicher formuliert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated on your iPhone from your data, never inventing a number. With Apple Intelligence (iOS 26), the text is reworded more naturally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado en tu iPhone a partir de tus datos, sin inventar nunca una cifra. Con Apple Intelligence (iOS 26), el texto se reformula de forma más natural."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé sur ton iPhone à partir de tes données, sans jamais inventer de chiffre. Avec Apple Intelligence (iOS 26), le texte est reformulé plus naturellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolato sul tuo iPhone a partire dai tuoi dati, senza mai inventare un numero. Con Apple Intelligence (iOS 26) il testo viene riformulato in modo più naturale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone上であなたのデータから計算され、数字を作り出すことは決してありません。Apple Intelligence（iOS 26）では、文章がより自然に言い換えられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado no seu iPhone a partir dos seus dados, sem nunca inventar um número. Com a Apple Intelligence (iOS 26), o texto é reformulado de forma mais natural."
          }
        }
      }
    },
