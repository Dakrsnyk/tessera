    "Tes repas, ta séance, tes cours, tes habitudes… Renseigne ce qui te concerne : Tessera réunit chaque jour ce qui compte.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mahlzeiten, dein Training, deine Kurse, deine Gewohnheiten… Trag ein, was für dich wichtig ist: Tessera bringt jeden Tag zusammen, was zählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your meals, workout, classes, habits… Fill in what matters to you: Tessera brings together what counts every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus comidas, tu entrenamiento, tus clases, tus hábitos… Completa lo que te interesa: Tessera reúne cada día lo que importa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes repas, ta séance, tes cours, tes habitudes… Renseigne ce qui te concerne : Tessera réunit chaque jour ce qui compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi pasti, il tuo allenamento, i tuoi corsi, le tue abitudini… Inserisci ciò che ti riguarda: Tessera riunisce ogni giorno ciò che conta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事、ワークアウト、授業、習慣… あなたに関係することを入力すると、Tesseraが毎日大切なことをまとめます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas refeições, seu treino, suas aulas, seus hábitos… Preencha o que importa para você: Tessera reúne todo dia o que conta."
          }
        }
      }
    },
    "Tes revenus récurrents et les ventes du jour.": {
