    "Lire, marcher, méditer… Coche-les chaque jour et regarde ta série grandir.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesen, spazieren, meditieren … Hake sie jeden Tag ab und sieh zu, wie deine Serie wächst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read, walk, meditate… Check them off every day and watch your streak grow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer, caminar, meditar… Márcalos cada día y mira crecer tu racha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire, marcher, méditer… Coche-les chaque jour et regarde ta série grandir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggere, camminare, meditare… Spunta le abitudini ogni giorno e guarda crescere la tua serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読書、散歩、瞑想…毎日チェックして、連続記録を伸ばしましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler, caminhar, meditar… Marque a cada dia e veja sua sequência crescer."
          }
        }
      }
    },
