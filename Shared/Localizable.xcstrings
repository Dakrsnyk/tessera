          }
        }
      }
    },
    "Mains au mur, jambe arrière tendue, talon au sol.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hände an der Wand, hinteres Bein gestreckt, Ferse am Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands on the wall, back leg straight, heel down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manos en la pared, pierna trasera estirada, talón en el suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mains au mur, jambe arrière tendue, talon au sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mani al muro, gamba posteriore tesa, tallone a terra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁に手を付け、後ろの脚は伸ばし、かかとは床に。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mãos na parede, perna de trás esticada, calcanhar no chão."
          }
        }
      }
    },
    "Mains au sol un peu plus larges que les épaules, corps gainé en ligne droite des talons à la tête.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hände etwas weiter als schulterbreit am Boden, Körper in einer geraden Linie von den Fersen bis zum Kopf angespannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands on the floor slightly wider than your shoulders, body braced in a straight line from heels to head."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manos en el suelo un poco más anchas que los hombros, cuerpo firme en línea recta de los talones a la cabeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mains au sol un peu plus larges que les épaules, corps gainé en ligne droite des talons à la tête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mani a terra un po' più larghe delle spalle, corpo teso in linea retta dai talloni alla testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手は肩幅より少し広めに床につき、かかとから頭まで一直線に体を固めます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mãos no chão um pouco mais afastadas que os ombros, corpo firme em linha reta dos calcanhares à cabeça."
          }
        }
      }
    },
    "Mains jointes devant toi, coudes contre l'intérieur des genoux.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hände vor dir zusammen, Ellbogen innen an den Knien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands together in front of you, elbows against the inside of your knees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manos juntas frente a ti, codos contra el interior de las rodillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mains jointes devant toi, coudes contre l'intérieur des genoux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mani giunte davanti a te, gomiti contro l'interno delle ginocchia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "胸の前で手を合わせ、ひじをひざの内側に当てます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mãos juntas à sua frente, cotovelos contra a parte interna dos joelhos."
          }
        }
      }
    },
    "Mains largeur d'épaules, coudes près du corps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hände schulterbreit, Ellbogen nah am Körper."
          }
