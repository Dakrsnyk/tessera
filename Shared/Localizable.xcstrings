          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, torso inclinado casi horizontal, espalda recta, rodillas flexionadas, mancuernas bajo los hombros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, buste penché presque à l'horizontale, dos plat, genoux fléchis, haltères sous les épaules."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi, busto inclinato quasi in orizzontale, schiena piatta, ginocchia piegate, manubri sotto le spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
