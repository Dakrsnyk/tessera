    "L'objectif de pas se règle dans « Mes informations ». Pour le détail de tes calories, l'app Santé reste la référence.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schrittziel stellst du unter „Meine Infos“ ein. Für Details zu deinen Kalorien bleibt die Health-App die Referenz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your step goal in “My info”. For the details of your calories, the Health app remains the reference."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El objetivo de pasos se ajusta en «Mis datos». Para el detalle de tus calorías, la app Salud sigue siendo la referencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'objectif de pas se règle dans « Mes informations ». Pour le détail de tes calories, l'app Santé reste la référence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'obiettivo di passi si imposta in «Le mie info». Per il dettaglio delle calorie, l'app Salute resta il riferimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歩数の目標は「マイ情報」で設定できます。カロリーの詳細は、引き続きヘルスケアアプリが基準です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A meta de passos é definida em “Minhas informações”. Para o detalhe das suas calorias, o app Saúde continua sendo a referência."
          }
        }
      }
    },
