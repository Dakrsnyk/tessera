    "La kettlebell monte à hauteur de poitrine, bras tendus, puis redescend en balancier.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kettlebell steigt mit gestreckten Armen auf Brusthöhe und schwingt dann zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The kettlebell rises to chest height, arms straight, then swings back down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La kettlebell sube a la altura del pecho, brazos extendidos, y luego baja como un péndulo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La kettlebell monte à hauteur de poitrine, bras tendus, puis redescend en balancier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La kettlebell sale all'altezza del petto, braccia tese, poi riscende oscillando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕を伸ばしたままケトルベルが胸の高さまで上がり、振り子のように戻ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O kettlebell sobe até a altura do peito, braços estendidos, e desce de novo como um pêndulo."
          }
        }
      }
    },
