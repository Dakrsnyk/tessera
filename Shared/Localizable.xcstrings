    "Elle repeint tout le widget : fond, cartes, texte, chiffres, icônes, graphiques et bordure.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie färbt das ganze Widget neu: Hintergrund, Karten, Text, Zahlen, Symbole, Diagramme und Rahmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It repaints the whole widget: background, cards, text, numbers, icons, charts and border."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repinta todo el widget: fondo, tarjetas, texto, cifras, iconos, gráficos y borde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle repeint tout le widget : fond, cartes, texte, chiffres, icônes, graphiques et bordure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridipinge tutto il widget: sfondo, schede, testo, numeri, icone, grafici e bordo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景、カード、テキスト、数字、アイコン、グラフ、枠線など、ウィジェット全体の色を塗り替えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repinta todo o widget: fundo, cartões, texto, números, ícones, gráficos e borda."
          }
        }
      }
    },
    "Elle se pose sur l'avant-bras, coude collé au buste, main à hauteur du menton.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie landet auf dem Unterarm, Ellbogen am Oberkörper, Hand auf Kinnhöhe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It lands on your forearm, elbow tucked against your torso, hand at chin height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se apoya en el antebrazo, con el codo pegado al torso y la mano a la altura de la barbilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle se pose sur l'avant-bras, coude collé au buste, main à hauteur du menton."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si appoggia sull'avambraccio, gomito contro il busto, mano all'altezza del mento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ケトルベルは前腕に乗り、ひじは体につけ、手はあごの高さに。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela se apoia no antebraço, cotovelo colado ao tronco, mão na altura do queixo."
          }
        }
      }
    },
    "Elles nourrissent tes widgets.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie versorgen deine Widgets."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They power your widgets."
          }
        },
        "es": {
