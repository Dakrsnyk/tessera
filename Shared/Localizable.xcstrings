    "Reviens au centre puis tourne de l'autre côté.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komm zur Mitte zurück und dreh dich zur anderen Seite."
          }
        },
        "en": {
          "stringUnit": {
