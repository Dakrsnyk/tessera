    "Fais glisser une carte pour la déplacer. ½ : à côté d'une autre carte ; Large : toute la largeur.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe eine Karte, um sie zu verschieben. ½: neben einer anderen Karte; Breit: volle Breite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a card to move it. ½: next to another card; Wide: full width."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una tarjeta para moverla. ½: junto a otra tarjeta; Ancha: todo el ancho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser une carte pour la déplacer. ½ : à côté d'une autre carte ; Large : toute la largeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina una scheda per spostarla. ½: accanto a un'altra scheda; Larga: tutta la larghezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードをドラッグして移動します。½：ほかのカードと並べる、ワイド：全幅。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um cartão para movê-lo. ½: ao lado de outro cartão; Largo: largura total."
          }
        }
      }
    },
    "Fais le mouvement lentement et sous contrôle.": {
