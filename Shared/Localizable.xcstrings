    "Monte sur le coude opposé, puis sur la main.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stütz dich auf den gegenüberliegenden Ellbogen, dann auf die Hand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come up onto the opposite elbow, then onto your hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apóyate en el codo opuesto y luego en la mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte sur le coude opposé, puis sur la main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggiati sul gomito opposto, poi sulla mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反対のひじ、次に手をついて起き上がります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoie-se no cotovelo oposto e depois na mão."
          }
        }
      }
    },
    "Monte un genou à hauteur de hanche.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebe ein Knie auf Hüfthöhe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift one knee to hip height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube una rodilla hasta la altura de la cadera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte un genou à hauteur de hanche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta un ginocchio all'altezza del fianco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひざを腰の高さまで上げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba um joelho até a altura do quadril."
          }
        }
      }
    },
    "Monter au-dessus des épaules.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
