          "stringUnit": {
            "state": "translated",
            "value": "Salte com os pés para trás até a prancha."
          }
        }
      }
    },
    "Saute pour revenir pieds joints, bras le long du corps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Springe zurück, Füße geschlossen, Arme seitlich am Körper."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump back to feet together, arms at your sides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta para volver a juntar los pies, con los brazos a los lados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saute pour revenir pieds joints, bras le long du corps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta per tornare a piedi uniti, braccia lungo il corpo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャンプして足を閉じ、腕を体の横に戻します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pule para voltar com os pés juntos, braços ao lado do corpo."
          }
        }
      }
    },
    "Saute sur la boîte à deux pieds, descends en marchant.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Springe mit beiden Füßen auf die Box, steige gehend wieder ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump onto the box with both feet, step down."
          }
        },
        "es": {
